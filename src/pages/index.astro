---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import PersonCard from "../components/PersonCard.astro";
import Carousel from "../components/Carousel.astro";
import PersonDialog from "../components/PersonDialog.astro";
import BodyDialog from "../components/BodyDialog.astro";
import StatuteDialog from "../components/StatuteDialog.astro";
import ResolutionDialog from "../components/ResolutionDialog.astro";
import DocCard from "../components/DocCard.astro";
import PartnerCard from "../components/PartnerCard.astro";
import {
  assignmentsByPerson, bodiesByPerson, getBodies, getNationalTeams,
  bodyTypeLabel, documentsOfType, getDocuments, getOrganisation, getPartners,
  getResolutions, getStatute, latestYear, orderBodies, roleLabel, teamTitle,
} from "../lib/api";

// Both calls run at BUILD time, so no visitor ever waits on Cloud Run and the
// single always-on container serves nobody's page views.
const [teams, org, bodies, statute, documents, resolutions, partners] = await Promise.all([
  getNationalTeams(), getOrganisation(), getBodies(), getStatute(),
  getDocuments(), getResolutions(), getPartners(),
]);

// The three shelves. `documentsOfType` matches on the API's own `doc_type`,
// which ships with surfpoland#33 — until then every document has none and the
// two document carousels are empty while Uchwały fills from its own endpoint.
// The document shelves, in the order they are read. Data rather than four
// copies of the same markup: they differ only by label and filter, and the
// third copy was already one too many.
//
// `Inne` sits LAST because OTHER is the fallback rather than a peer — the same
// reason it sorts last in the admin's type picker. Anything uncategorised is
// still worth publishing; it is just not what somebody came looking for.
const docShelves = [
  { label: "Transparentność", docs: documentsOfType(documents, "TRANSPARENCY") },
  { label: "Formularze", docs: documentsOfType(documents, "FORM") },
  { label: "Inne", docs: documentsOfType(documents, "OTHER") },
].filter((shelf) => shelf.docs.length > 0);

// A date reads better than a timestamp on a card, and the API already sends
// only the date part.
const dayOf = (iso: string | null) => (iso ?? "").slice(0, 10) || null;

// Whether the Dokumenty section exists at all — the nav entry follows it, so
// the menu never points at an anchor that is not on the page.
const hasDocuments = resolutions.length > 0 || docShelves.length > 0;
const year = latestYear(teams);

// Current season only. Older squads become their own page once the API returns
// more than one year; today it returns 2026.
const season = teams
  .filter((t) => t.year === year)
  .sort((a, b) => teamTitle(a).localeCompare(teamTitle(b), "pl"));

// Still counted, but only for the share description — the page itself no
// longer prints a tally under the heading.
const athletes = season.reduce((n, t) => n + t.member_count, 0);

// Built from ALL teams, not just the season on show, so a dialog lists every
// squad a person belongs to — which for nine of the twenty-six is more than one.
const assignments = assignmentsByPerson(teams);

// The federation's board and its committees. Board first — it is the body a
// visitor is looking for — then the komisje alphabetically.
const orderedBodies = orderBodies(bodies);
const bodyRows = bodiesByPerson(bodies);
---
<Base
  title="Polski Związek Surfingu"
  description={`Oficjalna strona Polskiego Związku Surfingu. Kadra narodowa ${year ?? ""}: ${athletes} zawodniczek i zawodników w ${season.length} kadrach.`}
>
  <div class="hero-wrap">
    <SiteHeader hasDocuments={hasDocuments} />
    <Hero
      title="Polski Związek Surfingu"
      lede="Krajowa federacja surfingu — kadra narodowa, zawody i kluby zrzeszone w całej Polsce."
    />
  </div>

  <main class="page" id="kadra">
    <div class="section__head">
      <h2 class="section__title">Kadra Narodowa {year}</h2>
      {/* Opens the platform's own national-team page, which carries what this
          page deliberately does not: earlier seasons, roles and the full card
          for each athlete. `rel="noopener"` is not optional with target=_blank
          — without it the opened page gets a handle on this one through
          window.opener. The label says where it goes, so a screen reader is not
          left with a bare "more". */}
      <a class="section__more" href="https://surfpoland.com/national-teams"
         target="_blank" rel="noopener noreferrer">
        Więcej na surfpoland.com
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" />
        </svg>
      </a>
    </div>

    {season.map((team) => (
      <section class="squad">
        <h3 class="squad__name">
          {teamTitle(team)}
          <span class="squad__count">{team.member_count}</span>
        </h3>
        <Carousel label={`Kadra ${teamTitle(team)}`}>
          {team.members.map((m) => (
            <PersonCard
              member={m}
              subtitle={m.categories.join(" · ")}
              group="Kadra narodowa"
              rows={(assignments.get(m.display_name) ?? []).map((a) => ({
                label: `${a.year} — ${a.team}`,
                detail: a.categories,
              }))}
            />
          ))}
        </Carousel>
      </section>
    ))}
  </main>

  {/* A sunken band, so the governance section reads as a different part of the
      record rather than more of the same list. Full-bleed like the hero: it
      sits OUTSIDE .page and re-centres its own content. */}
  <section class="band band--sunken" id="wladze">
    <div class="band__inner">
      <div class="section__head">
        <h2 class="section__title">Zarząd i komisje</h2>
        {/* The federation's own page on the platform, which carries what this
            section does not: the statute, the documents shelf, the affiliated
            clubs and each body's full membership over time.

            Trailing slash on purpose — surfpoland.com 301s the bare path to it,
            so linking the canonical form saves every visitor a redirect.

            Same treatment as the Kadra link above, deliberately: two different
            shapes for "there is more of this elsewhere" would read as two
            different kinds of thing. */}
        <a class="section__more" href="https://surfpoland.com/organisations/polski-zwiazek-surfingu/"
           target="_blank" rel="noopener noreferrer">
          Więcej na surfpoland.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      </div>

      {orderedBodies.map((body) => {
        /* The BODY's own crest, falling back to the federation's mark only
           when a body has none. It was the federation's mark unconditionally,
           which made all eight komisje look identical — the crests existed all
           along, the public API just did not return them (surfpoland#31). The
           fallback stays because the field is genuinely optional, and because
           it is what renders until that change is deployed. */
        const crest = body.image_url || org.image_url || "";
        return (
        <section class="squad">
          {/* A BUTTON only when there is something to open. Zarząd currently
              has no description, and a control that opens an empty dialog is
              worse than no control — it teaches people the row does nothing.
              Give it a description in the admin and it becomes clickable with
              no change here. */}
          <h3 class="squad__name">
            {body.description ? (
              <button
                type="button"
                class="squad__row"
                data-body
                data-body-name={body.name}
                data-body-type={bodyTypeLabel(body.body_type)}
                data-body-count={`${body.member_count} ${body.member_count === 1 ? "osoba" : "osób"}`}
                data-body-desc={body.description}
                data-body-crest={crest}
              >
                {crest && <img class="squad__crest" src={crest} alt="" width="28" height="28" />}
                <span class="squad__label">{body.name}</span>
                <span class="squad__count">{body.member_count}</span>
              </button>
            ) : (
              <span class="squad__row squad__row--static">
                {crest && <img class="squad__crest" src={crest} alt="" width="28" height="28" />}
                <span class="squad__label">{body.name}</span>
                <span class="squad__count">{body.member_count}</span>
              </span>
            )}
          </h3>
          <Carousel label={body.name}>
            {body.members.map((m) => (
              <PersonCard
                member={m}
                subtitle={roleLabel(m.role)}
                  group="Władze"
                rows={bodyRows.get(m.display_name) ?? []}
              />
            ))}
          </Carousel>
        </section>
        );
      })}
    </div>
  </section>

  {/* ── Dokumenty ─────────────────────────────────────────────────────────
      Shelves, each a carousel: what the association DECIDED (uchwały, read in
      a dialog) and what it PUBLISHES (transparency filings, forms and
      everything else, downloaded as PDFs). Uchwały are their own block because
      they come from a different endpoint and open rather than download; the
      rest are the same card driven by `docShelves`.

      A shelf with nothing on it is left out, and the section itself is not
      rendered when every shelf is empty — an empty section teaches people the
      page is broken. */}
  {hasDocuments && (
    <section class="page" id="dokumenty">
      <div class="section__head">
        <h2 class="section__title">Dokumenty</h2>
      </div>

      {resolutions.length > 0 && (
        <section class="squad">
          <h3 class="squad__name">
            <span class="squad__label">Uchwały</span>
            <span class="squad__count">{resolutions.length}</span>
          </h3>
          <Carousel label="Uchwały">
            {resolutions.map((r) => (
              <DocCard
                title={r.title}
                eyebrow={r.resolution_number}
                footnote={dayOf(r.adopted_on)}
                resolution={{
                  number: r.resolution_number,
                  title: r.title,
                  meta: [r.meeting_title, dayOf(r.adopted_on)].filter(Boolean).join(" · "),
                  body: r.content ?? "",
                }}
              />
            ))}
          </Carousel>
        </section>
      )}

      {docShelves.map((shelf) => (
        <section class="squad">
          <h3 class="squad__name">
            <span class="squad__label">{shelf.label}</span>
            <span class="squad__count">{shelf.docs.length}</span>
          </h3>
          <Carousel label={shelf.label}>
            {shelf.docs.map((d) => (
              <DocCard title={d.title} eyebrow={dayOf(d.doc_date)}
                footnote={d.file_name} href={d.file_url} />
            ))}
          </Carousel>
        </section>
      ))}
    </section>
  )}

  {/* ── Partnerzy ─────────────────────────────────────────────────────────
      NOT a section and NOT in the menu. Partners are an acknowledgement, not
      somewhere a visitor navigates to — so this sits directly on top of the
      footer with no gap between them, reading as the top of that block rather
      than as the last thing on the page.

      Publication is opt-in per row, so an empty list is the normal state and
      the strip simply does not render.

      `aria-label`, not `aria-labelledby`: the visible heading is gone, so the
      region needs a name of its own or it announces as an unlabelled group of
      links. The logos say what this is to anyone who can see them. */}
  {partners.length > 0 && (
    <section class="partners" aria-label="Partnerzy">
      <div class="partners__inner">
        <ul class="partners__list">
          {partners.map((p) => (
            <li><PartnerCard name={p.name} logoUrl={p.logo_url} url={p.url} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <SiteFooter org={org} />

  {/* One dialog for every card on the page. */}
  <PersonDialog />
  <BodyDialog />
  <StatuteDialog statute={statute} />
  <ResolutionDialog />
</Base>

<style>
  /* The header is absolutely positioned, so it needs a positioned ancestor it
     shares with the hero — otherwise it anchors to the page and scrolls away
     from the footage it is meant to sit on. */
  .hero-wrap { position: relative; }

  /* ── Partnerzy, glued to the footer ───────────────────────────────────────
     The footer carries `margin-top: var(--space-7)` to hold itself off the page.
     When this strip is present it takes that gap over and the footer's own is
     removed, so the two meet with no seam — which is what "on top of the
     footer" means. `:global(.foot)` because the footer is another component and
     a scoped selector would never match it. */
  .partners {
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .partners + :global(.foot) { margin-top: 0; }

  .partners__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  /* CENTRED, and wrapping rather than scrolling. A carousel is for a list you
     work through; this is a wall you take in at a glance, and a centred wrap
     stays centred at three logos and at thirty. */
  .partners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* A band set BACK from the page rather than raised above it — one step darker
     than the ground, which is what distinguishes a section without needing a
     rule or a heavier heading. It carries the page's own gutters because it
     sits outside .page. */
  .band--sunken {
    background: var(--palette-paper-sunken);
    padding-block: var(--space-6);
    margin-top: var(--space-6);
  }
  .band--sunken .band__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  /* Cards on the sunken band keep their white face: the contrast that makes a
     card read as a card is with whatever is behind it, and behind it is now
     darker, so nothing needs restating. */

  .section__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
    color: var(--color-text);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .section__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-button);
    text-decoration: none;
    white-space: nowrap;
  }
  .section__more:hover { color: var(--color-accent); }
  .section__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* space-4, not space-6. At 64px the squads read as four separate sections
     that happen to share a page; at 24px they read as one roster in four
     parts, which is what they are. The heading's own top margin does the rest
     of the separating. */
  .squad { margin-bottom: var(--space-4); }
  .squad__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }
  .squad__count {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
  }

  /* The whole row — crest, name and count — is the target, so the thing you
     aim at is the thing you read. */
  .squad__row {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .squad__row--static { cursor: default; }
  .squad__row:not(.squad__row--static):hover .squad__label { color: var(--color-accent); }
  .squad__row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .squad__crest {
    width: 28px;
    height: 28px;
    /* A rounded rectangle rather than a circle. These crests are shields and
       wordmarks drawn to square edges, and a circular mask clipped the corners
       off every one of them — the shield's own outline is the thing that
       distinguishes one komisja's badge from the next. */
    border-radius: 6px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-raised);
    /* `contain`, not cover: a crest cropped to fill the box loses its edges,
       which is the part that makes it recognisable. */
    object-fit: contain;
    padding: 3px;
    flex: 0 0 auto;
  }
  .squad__label { transition: color 0.15s ease; }

</style>
