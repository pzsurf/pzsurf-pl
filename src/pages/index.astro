---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import { getNationalTeams, getOrganisation, latestYear, teamTitle } from "../lib/api";

// Both calls run at BUILD time, so no visitor ever waits on Cloud Run and the
// single always-on container serves nobody's page views.
const [teams, org] = await Promise.all([getNationalTeams(), getOrganisation()]);
const year = latestYear(teams);

// Current season only. Older squads become their own page once the API returns
// more than one year; today it returns 2026.
const season = teams
  .filter((t) => t.year === year)
  .sort((a, b) => teamTitle(a).localeCompare(teamTitle(b), "pl"));

const athletes = season.reduce((n, t) => n + t.member_count, 0);
---
<Base
  title="Polski Związek Surfingu"
  description={`Oficjalna strona Polskiego Związku Surfingu. Kadra narodowa ${year ?? ""}: ${athletes} zawodniczek i zawodników w ${season.length} kadrach.`}
>
  <div class="hero-wrap">
    <SiteHeader />
    <Hero
      title="Polski Związek Surfingu"
      lede="Krajowa federacja surfingu — kadra narodowa, zawody i kluby zrzeszone w całej Polsce."
    />
  </div>

  <main class="page" id="kadra">
    <h2 class="section__title">Kadra Narodowa {year}</h2>
    <p class="section__lede">
      {athletes} zawodniczek i zawodników w {season.length} kadrach.
    </p>

    {season.map((team) => (
      <section class="squad">
        <h3 class="squad__name">
          {teamTitle(team)}
          <span class="squad__count">{team.member_count}</span>
        </h3>
        <ul class="roster">
          {team.members.map((m) => (
            <li class="roster__item">
              <span class="roster__name">{m.display_name}</span>
              {m.categories.length > 0 && (
                <span class="roster__cats">{m.categories.join(" · ")}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>

  <SiteFooter org={org} />
</Base>

<style>
  /* The header is absolutely positioned, so it needs a positioned ancestor it
     shares with the hero — otherwise it anchors to the page and scrolls away
     from the footage it is meant to sit on. */
  .hero-wrap { position: relative; }

  .section__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
    color: var(--color-text);
  }
  .section__lede {
    margin: var(--space-2) 0 var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .squad { margin-bottom: var(--space-5); }
  .squad__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    /* The one place the brand red appears on a light ground. Once per squad,
       never decoratively. */
    border-bottom: 2px solid var(--color-accent);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }
  .squad__count {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .roster__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-raised);
    border-radius: var(--radius);
  }
  .roster__cats { color: var(--color-text-faint); font-size: var(--text-xs); }
</style>
