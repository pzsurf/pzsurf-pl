---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import GroupCard from "../components/GroupCard.astro";
import GroupDialog from "../components/GroupDialog.astro";
import ShelfDialog from "../components/ShelfDialog.astro";
import StatuteDialog from "../components/StatuteDialog.astro";
import PartnersStrip from "../components/PartnersStrip.astro";
import OrgCard from "../components/OrgCard.astro";
import OrgDialog from "../components/OrgDialog.astro";
import EventCard from "../components/EventCard.astro";
import type { NationalTeam } from "../lib/api";
import {
  getAffiliates, getBodies, getNationalTeams,
  bodyTypeLabel, documentsOfType, getDocuments, getEvents, getOrganisation,
  getOrganisationDetail, getPartners, getResolutions, getStatute, latestYear,
  orderAffiliates, orderBodies, orderEvents, resolutionSlugs, roleLabel,
  teamTitle,
} from "../lib/api";
import { renderIntro } from "../lib/intro";

// Both calls run at BUILD time, so no visitor ever waits on Cloud Run and the
// single always-on container serves nobody's page views.
const [teams, org, bodies, statute, documents, resolutions, partners, events, affiliates] =
  await Promise.all([
    getNationalTeams(), getOrganisation(), getBodies(), getStatute(),
    getDocuments(), getResolutions(), getPartners(), getEvents(), getAffiliates(),
  ]);

// The clubs, schools and associations the federation licenses, in reading
// order. One dialog id per organisation, derived from the slug the API already
// guarantees is unique and stable.
const members = orderAffiliates(affiliates);
const memberDialogId = (slug: string) => `org-${slug}`;

// The dialogs show a blurb and contact details, and the affiliates LIST carries
// neither — so each organisation's full record is fetched by slug. Fourteen
// extra requests at BUILD time and none at read time: the HTML is written once
// and served as a file. In parallel, because they do not depend on each other.
const memberDetails = await Promise.all(
  members.map((m) => getOrganisationDetail(m.slug)),
);

// What the federation runs. Upcoming first, then what is over — see orderEvents.
const calendar = orderEvents(events);

// The federation's introduction, written in the platform. When there is one it
// IS the hero — it takes the place of the name and the fixed strapline passed
// below, which stay as the fallback for as long as nobody has written one.
const intro = org.intro_md?.trim() ? renderIntro(org.intro_md) : null;

// The three shelves. `documentsOfType` matches on the API's own `doc_type`,
// which ships with surfpoland#33 — until then every document has none and the
// two document carousels are empty while Uchwały fills from its own endpoint.
// The document shelves, in the order they are read. Data rather than four
// copies of the same markup: they differ only by label and filter, and the
// third copy was already one too many.
//
// `Inne` sits LAST because OTHER is the fallback rather than a peer — the same
// reason it sorts last in the admin's type picker. Anything uncategorised is
// still worth publishing; it is just not what somebody came looking for.
const docShelves = [
  { label: "Transparentność", docs: documentsOfType(documents, "TRANSPARENCY") },
  { label: "Formularze", docs: documentsOfType(documents, "FORM") },
  { label: "Inne", docs: documentsOfType(documents, "OTHER") },
].filter((shelf) => shelf.docs.length > 0);

// A date reads better than a timestamp on a card, and the API already sends
// only the date part.
const dayOf = (iso: string | null) => (iso ?? "").slice(0, 10) || null;

// Whether the Dokumenty section exists at all — the nav entry follows it, so
// the menu never points at an anchor that is not on the page.
const hasDocuments = resolutions.length > 0 || docShelves.length > 0;
const year = latestYear(teams);

// Current season only. Older squads become their own page once the API returns
// more than one year; today it returns 2026.
const season = teams
  .filter((t) => t.year === year)
  .sort((a, b) => teamTitle(a).localeCompare(teamTitle(b), "pl"));

// Still counted, but only for the share description — the page itself no
// longer prints a tally under the heading.
const athletes = season.reduce((n, t) => n + t.member_count, 0);

// A dialog per group, so each needs an id its card can point at. Derived from
// the words the reader sees on the card rather than from an index, so an anchor
// survives a squad or a komisja being added, renamed or reordered.
const groupId = (prefix: string, label: string) =>
  prefix + "-" + label
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const divisionId = (team: NationalTeam) => groupId("kadra", teamTitle(team));

// Every shelf in Dokumenty, as one list: a card and a dialog each, whatever the
// rows point at. Uchwały are a shelf like the others now — each one has a page
// of its own (src/pages/uchwaly/[slug].astro), so a row is an address to share
// rather than a dialog to read, which is what the three file shelves always
// were.
const resSlugs = resolutionSlugs(resolutions);
const shelves = [
  ...(resolutions.length > 0
    ? [{
        id: "dokumenty-uchwaly",
        label: "Uchwały",
        // The eyebrow is the uchwała's number — what it is cited by.
        accentEyebrow: true,
        rows: resolutions.map((r) => ({
          title: r.title,
          eyebrow: r.resolution_number,
          footnote: [r.meeting_title, dayOf(r.adopted_on)].filter(Boolean).join(" · "),
          href: `/uchwaly/${resSlugs.get(r.id)}/`,
        })),
      }]
    : []),
  ...docShelves.map((shelf) => ({
    id: groupId("dokumenty", shelf.label),
    label: shelf.label,
    // A date, not a name: it stays small print.
    accentEyebrow: false,
    rows: shelf.docs.map((d) => ({
      title: d.title,
      eyebrow: dayOf(d.doc_date),
      footnote: d.file_name,
      href: d.file_url,
    })),
  })),
];


// The face stack on a card, and the people a dialog lists. Both read the same
// member rows; only the line under each name differs — age categories for an
// athlete, a governance role for a body's member.
const facesOf = (members: { display_name: string; image_url: string | null }[]) =>
  members.map((m) => ({ name: m.display_name, image: m.image_url }));

// The federation's board and its committees. Board first — it is the body a
// visitor is looking for — then the komisje alphabetically.
const orderedBodies = orderBodies(bodies);
---
<Base
  title="Polski Związek Surfingu"
  description={`Oficjalna strona Polskiego Związku Surfingu. Kadra narodowa ${year ?? ""}: ${athletes} zawodniczek i zawodników w ${season.length} kadrach.`}
>
  <div class="hero-wrap">
    <SiteHeader hasDocuments={hasDocuments} hasEvents={calendar.length > 0} />
    <Hero
      title="Polski Związek Surfingu"
      lede="Krajowa federacja surfingu — kadra narodowa, zawody i kluby zrzeszone w całej Polsce."
      intro={intro}
    />
  </div>

  <main class="page" id="kadra">
    <div class="section__head">
      <h2 class="section__title">Kadra Narodowa {year}</h2>
      {/* Opens the platform's own national-team page, which carries what this
          page deliberately does not: earlier seasons, roles and the full card
          for each athlete. `rel="noopener"` is not optional with target=_blank
          — without it the opened page gets a handle on this one through
          window.opener. The label says where it goes, so a screen reader is not
          left with a bare "more". */}
      <a class="section__more" href="https://surfpoland.com/national-teams"
         target="_blank" rel="noopener noreferrer">
        Więcej na surfpoland.com
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" />
        </svg>
      </a>
    </div>

    {/* One card per DIVISION, not twenty-six athletes in four carousels: the
        squads are what a visitor is choosing between, and the roster of the one
        they choose is what they came to read. Every name is still in this
        page's HTML — inside that division's own dialog — so link previews and
        crawlers see the full roster exactly as they did before. */}
    <ul class="groups">
      {season.map((team) => (
        <li>
          <GroupCard
            dialogId={divisionId(team)}
            title={teamTitle(team)}
            count={team.member_count}
            faces={facesOf(team.members)}
          />
        </li>
      ))}
    </ul>
  </main>

  {/* ── Wydarzenia ────────────────────────────────────────────────────────
      The federation's calendar: what is coming, then what has happened, the
      latter dimmed but still followable.

      Each card LINKS OUT — to the event's own site where it has one, to the
      platform's page otherwise — because that is where an event's details and
      its entry form live. Left out entirely when there is nothing to list, so
      the page never grows a heading that says "no events". ── */}
  {calendar.length > 0 && (
    <section class="page" id="wydarzenia">
      <div class="section__head">
        <h2 class="section__title">Wydarzenia</h2>
        {/* The platform's own calendar, which carries what this section does
            not: descriptions, locations, startlists and registration. Same
            treatment as the other sections' links, deliberately. */}
        <a class="section__more" href="https://surfpoland.com/events"
           target="_blank" rel="noopener noreferrer">
          Więcej na surfpoland.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      </div>
      <ul class="groups">
        {calendar.map((ev) => (
          <li><EventCard event={ev} /></li>
        ))}
      </ul>
    </section>
  )}

  {/* A sunken band, so the governance section reads as a different part of the
      record rather than more of the same list. Full-bleed like the hero: it
      sits OUTSIDE .page and re-centres its own content. */}
  <section class="band band--sunken" id="wladze">
    <div class="band__inner">
      <div class="section__head">
        <h2 class="section__title">Zarząd i komisje</h2>
        {/* The federation's own page on the platform, which carries what this
            section does not: the statute, the documents shelf, the affiliated
            clubs and each body's full membership over time.

            Trailing slash on purpose — surfpoland.com 301s the bare path to it,
            so linking the canonical form saves every visitor a redirect.

            Same treatment as the Kadra link above, deliberately: two different
            shapes for "there is more of this elsewhere" would read as two
            different kinds of thing. */}
        <a class="section__more" href="https://surfpoland.com/organisations/polski-zwiazek-surfingu/"
           target="_blank" rel="noopener noreferrer">
          Więcej na surfpoland.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      </div>

      {/* One card per body, opening its own dialog — the same shape the roster
          above uses, because a komisja and a squad are the same kind of thing to
          a reader: a name, a headcount, and a list of people worth opening.

          Every body is openable now. The dialog carries the remit AND the
          membership, so one without a description still has something to show —
          which is why the old "no description, no button" rule is gone. */}
      <ul class="groups">
        {orderedBodies.map((body) => (
          <li>
            <GroupCard
              dialogId={groupId("organ", body.name)}
              title={body.name}
              count={body.member_count}
              faces={facesOf(body.members)}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Dokumenty ─────────────────────────────────────────────────────────
      Shelves, each a carousel: what the association DECIDED (uchwały, read in
      a dialog) and what it PUBLISHES (transparency filings, forms and
      everything else, downloaded as PDFs). Uchwały are their own block because
      they come from a different endpoint and open rather than download; the
      rest are the same card driven by `docShelves`.

      A shelf with nothing on it is left out, and the section itself is not
      rendered when every shelf is empty — an empty section teaches people the
      page is broken. */}
  {hasDocuments && (
    <section class="page" id="dokumenty">
      <div class="section__head">
        <h2 class="section__title">Dokumenty</h2>
      </div>

      {/* One card per shelf, opening a list of its documents — the same shape
          the roster and the komisje use above. A row in that list is a LINK to
          the document itself, so it opens in its own tab and the address can be
          shared. */}
      <ul class="groups">
        {shelves.map((shelf) => (
          <li>
            <GroupCard
              dialogId={shelf.id}
              title={shelf.label}
              count={shelf.rows.length}
              faces={[]}
            />
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── Zrzeszone organizacje ─────────────────────────────────────────────
      A LIGHT band on purpose. The crests come from fourteen different
      designers and many are black on transparent; a black band would swallow
      them, which is the whole reason surfpoland.com gives each crest a light
      tile. Here the band is light already and the tile only evens them out.

      Not rendered at all when the register is empty — an empty section teaches
      people the page is broken, the same rule the document shelves follow. */}
  {members.length > 0 && (
    <section class="page" id="organizacje">
      <div class="section__head">
        <h2 class="section__title">Zrzeszone organizacje</h2>
        <a class="section__more" href="https://surfpoland.com/organisations/"
           target="_blank" rel="noopener noreferrer">
          Więcej na surfpoland.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      </div>

      <ul class="orgs">
        {members.map((o) => (
          <li>
            <OrgCard dialogId={memberDialogId(o.slug)} name={o.name} crest={o.image_url} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── Partnerzy ─────────────────────────────────────────────────────────
      NOT a section and NOT in the menu. Partners are an acknowledgement, not
      somewhere a visitor navigates to — so this sits directly on top of the
      footer with no gap between them.

      The strip centres itself when the logos fit and rotates them when they do
      not; it owns that decision, so this file just hands it the list.

      Publication is opt-in per row, so an empty list is the normal state and
      the strip simply does not render. */}
  {partners.length > 0 && <PartnersStrip partners={partners} />}

  <SiteFooter org={org} />

  {/* A dialog per group, each rendered with its own roster inside it: the
      season's divisions, then the board and its komisje. */}
  {season.map((team) => (
    <GroupDialog
      id={divisionId(team)}
      title={teamTitle(team)}
      count={team.member_count}
      meta={year !== null ? [`Kadra Narodowa ${year}`] : []}
      people={team.members.map((m) => ({
        name: m.display_name,
        image: m.image_url,
        subtitle: m.categories.join(" · "),
      }))}
    />
  ))}
  {orderedBodies.map((body) => (
    <GroupDialog
      id={groupId("organ", body.name)}
      title={body.name}
      count={body.member_count}
      meta={[bodyTypeLabel(body.body_type)]}
      description={body.description}
      people={body.members.map((m) => ({
        name: m.display_name,
        image: m.image_url,
        // "Członek" under two names in every three is noise: it is the default
        // and says nothing about the person. A role that DISTINGUISHES somebody
        // — Prezes, Przewodniczący, Wiceprzewodniczący — is the part worth
        // printing, so only the plain MEMBER code is dropped. Matched on the
        // CODE, never the label: the label is wording and may change.
        subtitle: m.role === "MEMBER" ? "" : roleLabel(m.role),
      }))}
    />
  ))}

  {/* A dialog per document shelf, each listing its own rows. */}
  {shelves.map((shelf) => (
    <ShelfDialog
      id={shelf.id}
      title={shelf.label}
      count={shelf.rows.length}
      rows={shelf.rows}
      accentEyebrow={shelf.accentEyebrow}
    />
  ))}

  {/* A dialog per affiliated organisation, each rendered with its own details
      inside it — so the whole register is in the document for a crawler, not
      just the fourteen crests. */}
  {memberDetails.map((o) => (
    <OrgDialog id={memberDialogId(o.slug)} org={o} />
  ))}

  <StatuteDialog statute={statute} />
</Base>

<style>
  /* The header is absolutely positioned, so it needs a positioned ancestor it
     shares with the hero — otherwise it anchors to the page and scrolls away
     from the footage it is meant to sit on. */
  .hero-wrap { position: relative; }

  /* A band set BACK from the page rather than raised above it — one step darker
     than the ground, which is what distinguishes a section without needing a
     rule or a heavier heading. It carries the page's own gutters because it
     sits outside .page. */
  .band--sunken {
    background: var(--palette-paper-sunken);
    padding-block: var(--space-6);
    margin-top: var(--space-6);
  }
  .band--sunken .band__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  /* Cards on the sunken band keep their white face: the contrast that makes a
     card read as a card is with whatever is behind it, and behind it is now
     darker, so nothing needs restating. */

  .section__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
    color: var(--color-text);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .section__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-button);
    text-decoration: none;
    white-space: nowrap;
  }
  .section__more:hover { color: var(--color-accent); }
  .section__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* One card per GROUP — a national-team division above, a governance body
     below. `auto-fill` with a 240px floor puts four across on a desktop, two on
     a tablet and one on a phone, without a breakpoint for each. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Denser than .groups: a crest and a name need far less room than a name,
     a headcount and a stack of four faces, and fourteen of them read as a
     register rather than as a list of choices. */
  .orgs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 130px, not the 112px this started at, and the difference is THREE columns
     against two. Measured across real phone widths: at 112px a 390px screen
     (iPhone 14/15) fits three 114px columns, and six club names are then wider
     than their line box, so `overflow-wrap: anywhere` chops them mid-word.
     360px happened to give two columns and look right, which is why it was
     easy to miss. 130px holds TWO columns from 320px through 430px with
     nothing chopped — the same value surfpoland.com's grid uses, for the same
     reason and against the same names. */
  @media (max-width: 640px) {
    .orgs { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
  }

  /* space-4, not space-6. At 64px the squads read as four separate sections
     that happen to share a page; at 24px they read as one roster in four
     parts, which is what they are. The heading's own top margin does the rest
     of the separating. */
  .squad { margin-bottom: var(--space-4); }
  .squad__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }
  .squad__count {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
  }


</style>
