---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import AthleteCard from "../components/AthleteCard.astro";
import Carousel from "../components/Carousel.astro";
import PersonDialog from "../components/PersonDialog.astro";
import { assignmentsByPerson, getNationalTeams, getOrganisation, latestYear, teamTitle } from "../lib/api";

// Both calls run at BUILD time, so no visitor ever waits on Cloud Run and the
// single always-on container serves nobody's page views.
const [teams, org] = await Promise.all([getNationalTeams(), getOrganisation()]);
const year = latestYear(teams);

// Current season only. Older squads become their own page once the API returns
// more than one year; today it returns 2026.
const season = teams
  .filter((t) => t.year === year)
  .sort((a, b) => teamTitle(a).localeCompare(teamTitle(b), "pl"));

// Still counted, but only for the share description — the page itself no
// longer prints a tally under the heading.
const athletes = season.reduce((n, t) => n + t.member_count, 0);

// Built from ALL teams, not just the season on show, so a dialog lists every
// squad a person belongs to — which for nine of the twenty-six is more than one.
const assignments = assignmentsByPerson(teams);
---
<Base
  title="Polski Związek Surfingu"
  description={`Oficjalna strona Polskiego Związku Surfingu. Kadra narodowa ${year ?? ""}: ${athletes} zawodniczek i zawodników w ${season.length} kadrach.`}
>
  <div class="hero-wrap">
    <SiteHeader />
    <Hero
      title="Polski Związek Surfingu"
      lede="Krajowa federacja surfingu — kadra narodowa, zawody i kluby zrzeszone w całej Polsce."
    />
  </div>

  <main class="page" id="kadra">
    <div class="section__head">
      <h2 class="section__title">Kadra Narodowa {year}</h2>
      {/* Opens the platform's own national-team page, which carries what this
          page deliberately does not: earlier seasons, roles and the full card
          for each athlete. `rel="noopener"` is not optional with target=_blank
          — without it the opened page gets a handle on this one through
          window.opener. The label says where it goes, so a screen reader is not
          left with a bare "more". */}
      <a class="section__more" href="https://surfpoland.com/national-teams"
         target="_blank" rel="noopener noreferrer">
        Więcej na surfpoland.com
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" />
        </svg>
      </a>
    </div>

    {season.map((team) => (
      <section class="squad">
        <h3 class="squad__name">
          {teamTitle(team)}
          <span class="squad__count">{team.member_count}</span>
        </h3>
        <Carousel label={`Kadra ${teamTitle(team)}`}>
          {team.members.map((m) => (
            <AthleteCard
              member={m}
              assignments={assignments.get(m.display_name) ?? []}
            />
          ))}
        </Carousel>
      </section>
    ))}
  </main>

  <SiteFooter org={org} />

  {/* One dialog for every card on the page. */}
  <PersonDialog />
</Base>

<style>
  /* The header is absolutely positioned, so it needs a positioned ancestor it
     shares with the hero — otherwise it anchors to the page and scrolls away
     from the footage it is meant to sit on. */
  .hero-wrap { position: relative; }

  .section__title {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
    color: var(--color-text);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .section__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-button);
    text-decoration: none;
    white-space: nowrap;
  }
  .section__more:hover { color: var(--color-accent); }
  .section__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* space-4, not space-6. At 64px the squads read as four separate sections
     that happen to share a page; at 24px they read as one roster in four
     parts, which is what they are. The heading's own top margin does the rest
     of the separating. */
  .squad { margin-bottom: var(--space-4); }
  .squad__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }
  .squad__count {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
  }

</style>
