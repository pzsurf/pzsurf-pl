---
import Base from "../layouts/Base.astro";
import { getNationalTeams, latestYear, teamTitle } from "../lib/api";

// Runs at BUILD time — `astro build` calls the API once and the result is
// baked into dist/. No visitor ever waits on Cloud Run for this page.
const teams = await getNationalTeams();
const year = latestYear(teams);

// Only the current season. Older squads are a page of their own once there is
// more than one season in the data; today the API returns 2026 only.
const season = teams
  .filter((t) => t.year === year)
  .sort((a, b) => teamTitle(a).localeCompare(teamTitle(b), "pl"));

const athletes = season.reduce((n, t) => n + t.member_count, 0);
---
<Base
  title={`Kadra Narodowa ${year ?? ""} — Polski Związek Surfingu`}
  description={`${athletes} zawodniczek i zawodników w ${season.length} kadrach narodowych w sezonie ${year ?? ""}.`}
>
  <header class="band on-dark">
    <div class="band__inner">
      <p class="masthead__eyebrow">Polski Związek Surfingu</p>
      <h1>Kadra Narodowa {year}</h1>
      <p class="masthead__lede">
        {athletes} zawodniczek i zawodników w {season.length} kadrach.
      </p>
    </div>
  </header>

  <main class="page">

    {season.map((team) => (
      <section class="squad">
        <h2 class="squad__name">
          {teamTitle(team)}
          <span class="squad__count">{team.member_count}</span>
        </h2>
        <ul class="roster">
          {team.members.map((m) => (
            <li class="roster__item">
              <span class="roster__name">{m.display_name}</span>
              {m.categories.length > 0 && (
                <span class="roster__cats">{m.categories.join(" · ")}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="foot">
      <p>
        Dane pochodzą z platformy
        <a href="https://surfpoland.com">surfpoland.com</a>.
      </p>
    </footer>
  </main>
</Base>

<style>
  /* Structure only — every value is a token, so the design language governs
     the look and this file never restates it. */
  /* A black band running edge to edge — the source site's main compositional
     device, light content between dark full-width sections. It sits OUTSIDE
     .page so it can reach the viewport edges, and re-centres its own content
     to the same measure. `.on-dark` re-points the role tokens; nothing in here
     is re-coloured by hand. */
  .band { padding-block: var(--space-6); }
  .band__inner {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  .masthead__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .masthead h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
  }
  .masthead__lede {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .squad { margin-bottom: var(--space-5); }
  .squad__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    /* The red rule under a section heading is the one place the brand colour
       appears on a light background. Used once per squad, never decoratively. */
    border-bottom: 2px solid var(--color-accent);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }
  .squad__count {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
  }

  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .roster__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-raised);
    border-radius: var(--radius);
  }
  .roster__cats { color: var(--color-text-faint); font-size: var(--text-xs); }

  .foot {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }
  .foot a { color: var(--color-accent); }
</style>
