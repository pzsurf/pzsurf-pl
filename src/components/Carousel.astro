---
// A horizontal, snapping track of cards.
//
// The scrolling is CSS — overflow-x plus scroll-snap — so it works with a
// swipe, a trackpad and the keyboard with NO JavaScript. The arrows are the
// only scripted part.
//
// They are written in the markup but `hidden`, and the script reveals them.
// The first attempt CREATED them in JS to avoid shipping inert buttons, and
// that failed in a way worth recording: Astro's <style> is scoped by a
// `data-astro-cid-*` attribute stamped onto elements in the TEMPLATE, so
// runtime-created nodes match none of it and the arrows rendered as unstyled
// browser buttons. Hidden-then-revealed gets both properties — scoped styles
// apply, and a visitor without JS sees no button rather than a dead one.
//
// The roster itself is never affected: every name is in the HTML as written,
// which is what keeps link previews and crawlers reading the full squad.
interface Props { label: string }
const { label } = Astro.props;
---
<div class="carousel" data-carousel>
  <div class="carousel__track" data-track tabindex="0" role="group" aria-label={label}>
    <slot />
  </div>
  <button type="button" class="carousel__arrow carousel__arrow--prev"
          data-dir="prev" aria-label="Poprzednie" hidden>‹</button>
  <button type="button" class="carousel__arrow carousel__arrow--next"
          data-dir="next" aria-label="Następne" hidden>›</button>
</div>

<style>
  .carousel { position: relative; }
  .carousel__track {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    /* PROXIMITY, not mandatory. Measured: with `x mandatory` this track refused
       to move at all — `scrollBy` and even a direct `scrollLeft = 250` were
       re-snapped straight back to its resting 4px, so both arrows were dead
       while looking perfectly alive. Proximity snaps when a scroll ends near a
       card and otherwise leaves the scroll alone, which is also the kinder
       behaviour on a long row: mandatory can trap a reader mid-list. */
    scroll-snap-type: x proximity;
    /* NO `scroll-behavior: smooth` here, deliberately. Measured in Chrome: with
       it set in CSS, `track.scrollBy({left})` called WITHOUT an explicit
       `behavior` silently does nothing — the arrows looked alive and moved the
       track not at all. The same call works with `behavior` passed explicitly,
       which is what the script now does, and that also lets it honour
       prefers-reduced-motion directly rather than through a media query. */
    /* FULL-BLEED: the track runs to both edges of the window while its content
       still starts in line with the heading above it.
       `margin-inline: calc(50% - 50vw)` pulls each edge out to the viewport —
       50% of this element's own width back, 50vw of the window forward — and
       the matching padding puts the inset back INSIDE the scroller. So the
       first card sits under the heading, and scrolling carries cards past the
       window edge instead of stopping short of it.
       `scroll-padding-inline` has to repeat the same figure or snapping would
       park a card flush against the window edge, undoing the alignment. */
    /* Room for the focus ring and the cards' edges, vertically. */
    padding-block: var(--space-1);
    margin-block: calc(var(--space-1) * -1);
    /* Mobile. The swipe itself is free — `overflow-x` on a touch device IS a
       swipe — but two things make it behave rather than merely work:
       `overscroll-behavior-x: contain` stops a swipe that reaches the end of
       the track from chaining into the browser's back-gesture, which on iOS
       and Android otherwise navigates away from the page mid-flick; and
       `-webkit-overflow-scrolling` keeps momentum on older iOS WebKit, where
       its absence makes the track stop dead under the finger. */
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    /* Only the horizontal gesture is claimed, so a vertical swipe still scrolls
       the PAGE with the finger on a card — `touch-action: none` here would trap
       the reader inside the carousel, which is the classic mobile carousel bug. */
    touch-action: pan-x pan-y;
  }

  .carousel__track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* The scrollbar is the ONLY affordance a visitor without JS gets, so it stays
     — until the arrows appear and make it redundant. */
  .carousel.is-enhanced .carousel__track { scrollbar-width: none; }
  .carousel.is-enhanced .carousel__track::-webkit-scrollbar { display: none; }

  .carousel__arrow {
    position: absolute;
    /* The media box is a square the width of a card, so its centre is half a
       card-width down — not half the component, which the captions skew. */
    top: 100px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    /* A cream disc on the cards rather than a red one (September 2026, the
       paper-like restyle): the arrow is a way to move, not a call to action,
       and the red now lives in the text it turns on hover. */
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg-raised);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-paper-lift);
    transition: color 0.15s ease;
  }
  .carousel__arrow:hover { color: var(--color-accent); }
  .carousel__arrow:disabled { opacity: 0; pointer-events: none; }
  .carousel__arrow--prev { left: -14px; }
  .carousel__arrow--next { right: -14px; }

  /* NARROW SCREENS ONLY: the track runs edge to edge.
     On a phone the content gutter is a large share of the width, so stopping
     the cards short of the edge wastes it and makes a swipe feel fenced in.
     On a desktop the same treatment reads as cards escaping the layout, so
     above this breakpoint the carousel stays inside the page container — which
     is also where the arrows live, so the two halves agree: contained with
     arrows above, edge-to-edge with a swipe below.

     Three things have to move together or the gutter fights the snapping:
       1. negative margins pull the track out to the window;
       2. pseudo-element SPACERS put the inset back as content — margins on
          `> :first-child` silently match nothing, because Astro scopes by a cid
          and the cards arrive through a <slot> carrying AthleteCard's;
       3. `scroll-padding-inline` moves the snapport in by the same amount,
          without which `scroll-snap-align: start` snaps the first card flush to
          the window and every scrollable carousel loads pre-scrolled. */
  @media (max-width: 900px) {
    .carousel__track {
      --gutter: var(--space-3);
      margin-inline: calc(50% - 50vw);
      scroll-padding-inline: var(--gutter);
    }
    .carousel__track::before,
    .carousel__track::after {
      content: "";
      /* Minus the flex gap, which already sits between spacer and first card. */
      flex: 0 0 calc(var(--gutter) - var(--space-2));
    }
  }

  /* No room to hang arrows outside the track on a phone, and a swipe is the
     natural gesture there — so the arrows go.

     The scrollbar used to come back with them, as the replacement affordance.
     It does not any more: the row is visibly CUT OFF at the edge, which says
     "there is more" without spending a strip of the card on saying it, and how
     far through a roster you are is not something anybody needs to read. A
     swipe needs no progress bar.

     Note what is NOT undone here: the rule above is `.is-enhanced`, set by the
     script, so a visitor without JS still gets the scrollbar on a phone. It is
     their only affordance and the one case where it is still doing work. */
  @media (max-width: 900px) {
    .carousel__arrow { display: none; }
  }
</style>

<script>
  // The only JavaScript on the site. Everything it adds is a convenience;
  // nothing it adds is content.
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const arrows = root.querySelectorAll<HTMLButtonElement>("[data-dir]");
    if (!track || arrows.length !== 2) continue;

    root.classList.add("is-enhanced");
    for (const b of arrows) {
      b.hidden = false;
      b.addEventListener("click", () => {
        // Just under a full view, so the card at the edge stays visible and the
        // reader keeps their place rather than being teleported.
        const step = track.clientWidth * 0.8;
        const delta = b.dataset.dir === "next" ? step : -step;

        // scrollTo with an ABSOLUTE, pre-clamped target — not scrollBy.
        // Measured in Chrome while building this: `scrollBy` on a snapping
        // track repeatedly resolved to no movement at all, while `scrollTo`
        // with an explicit target landed every time. A target we compute
        // ourselves also cannot overshoot into a snap position that does not
        // exist, which is the failure mode that makes an arrow look dead.
        const max = track.scrollWidth - track.clientWidth;
        const target = Math.max(0, Math.min(max, track.scrollLeft + delta));

        // `behavior` is passed explicitly and must stay that way — see the note
        // on scroll-behavior in the stylesheet above.
        const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        track.scrollTo({ left: target, behavior: smooth ? "smooth" : "auto" });
      });
    }

    // Hide an arrow that would do nothing — at either end, and when every card
    // already fits so the track cannot scroll at all.
    //
    // EDGE is not zero and not 1px. The track has its own padding, so at rest
    // scrollLeft is already a few pixels in (4, measured) and a `<= 1` test
    // never fires — the back arrow sat there enabled on a carousel that was
    // fully scrolled left. Browsers also report fractional scrollLeft at
    // fractional zoom. A dozen pixels of slack costs nothing: a genuinely
    // scrolled track is hundreds of pixels along.
    const EDGE = 12;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      for (const b of arrows) {
        b.disabled = b.dataset.dir === "prev"
          ? track.scrollLeft <= EDGE
          : track.scrollLeft >= max - EDGE;
      }
    };
    track.addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync);
    sync();
  }
</script>
