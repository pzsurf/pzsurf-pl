---
import type { TeamMember } from "../lib/api";
interface Props { member: TeamMember }
const { member } = Astro.props;

// Initials from whatever name we were given. "Marta B." -> MB, "Anna Nowak" -> AN.
// Built from display_name rather than from first/last, because those are not
// public fields — the API sends one already-formatted string and nothing else.
const initials = member.display_name
  .split(/\s+/)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---
<article class="card">
  {/* The photo slot exists whether or not there is a photo. Today every
      athlete resolves as a minor (date_of_birth is unset for most people, and
      the API treats unknown as minor), so image_url is null for all of them
      and every card shows its monogram. The moment a birth date and a
      publication consent are recorded, that person's card starts showing their
      photograph with no change here. */}
  <div class="card__media">
    {member.image_url
      ? <img src={member.image_url} alt={member.display_name} loading="lazy" width="320" height="320" />
      : <span class="card__monogram" aria-hidden="true">{initials}</span>}
  </div>
  <div class="card__body">
    <p class="card__name">{member.display_name}</p>
    {member.categories.length > 0 && (
      <p class="card__cats">{member.categories.join(" · ")}</p>
    )}
  </div>
</article>

<style>
  .card {
    /* Fixed width AND fixed height. The width keeps the track scrolling in even
       steps; the height is what makes a row of cards read as a row rather than
       a ragged edge — a two-line name would otherwise make one card taller than
       its neighbours. Both halves below are sized to add up to it exactly. */
    flex: 0 0 auto;
    width: 156px;
    height: 190px;
    scroll-snap-align: start;
    background: var(--color-bg-raised);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card__media {
    display: grid;
    place-items: center;
    /* An EXPLICIT height, not `aspect-ratio`, and that distinction was the bug.
       aspect-ratio only expresses a PREFERRED size: the image's `height: 100%`
       has no definite height to resolve against, so the box fell back to the
       photo's natural height and portrait shots blew it out to 234 and 237px
       while landscape ones happened to fit. Every card was 156x230 and the
       media inside them was not. A definite height fixes both the box and what
       the percentage resolves against. */
    height: 116px;
    /* Belt and braces: the box is definite now, so nothing should overflow —
       but if a future change makes one, it is clipped rather than shoving the
       name out of the card. */
    overflow: hidden;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .card__media img {
    display: block;
    width: 100%;
    height: 100%;
    /* `cover` fills the rectangle and crops whatever overflows; `center` decides
       WHICH part survives — the middle band of the photo, as asked. Worth
       knowing: on a full-length portrait the middle is the torso, so if faces
       start getting cut, `object-position: center 35%` biases the crop upward
       without changing anything else. */
    object-fit: cover;
    object-position: center;
  }
  .card__monogram {
    color: rgba(255, 255, 255, 0.65);
    font-size: 32px;
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
  }
  .card__body {
    /* 74px, and the card's 190 is exactly 116 + 74. Fixed rather than fluid so
       a card with no age categories does not come up short. */
    height: 74px;
    padding: 10px var(--space-2);
    overflow: hidden;
  }
  .card__name {
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
    font-weight: var(--weight-subhead);
    color: var(--color-text);
    /* Two lines, then ellipsis. NOT `nowrap`: full names arrived only once the
       API stopped abbreviating them, and truncating "Marta Budzanowska" to
       "Marta Budz…" would hand back what that change was for. Two lines fit
       every name on the current roster. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__cats {
    margin: var(--space-1) 0 0;
    color: var(--color-text-faint);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
