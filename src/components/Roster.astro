---
// A body's or a squad's people, as GroupDialog and BodyGroupDialog show them:
// the remit (when there is one) above a grid of portraits. One component so the
// roster reads the same whichever dialog it is in.
interface Props {
  /** A body's remit, as the API sends it: plain text with newlines. */
  description?: string | null;
  people: { name: string; image: string | null; subtitle: string }[];
}
const { description = null, people } = Astro.props;

const initials = (name: string) =>
  name.split(/\s+/).map((p) => p[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();
---
{/* `pre-wrap`, because the API sends plain text with newlines rather than
    markup: rendered as one block, four paragraphs run into a wall. */}
{description && <p class="group-dialog__desc">{description}</p>}

{/* A plain list: no buttons, no links, nothing focusable. The photograph is
    decorative because the name is directly underneath it — alt text
    repeating it would have a screen reader read every person twice. */}
<ul class="group-dialog__grid">
  {people.map((p) => (
    <li class="member">
      <span class="member__media">
        {p.image
          ? <img src={p.image} alt="" loading="lazy" width="160" height="213" />
          : <span class="member__monogram" aria-hidden="true">{initials(p.name)}</span>}
      </span>
      {/* Already abbreviated where the API decided it must be — a minor gets
          an abbreviated surname. Never expanded or re-joined here: the
          abbreviation IS the privacy control. */}
      <p class="member__name">{p.name}</p>
      {p.subtitle && <p class="member__role">{p.subtitle}</p>}
    </li>
  ))}
</ul>

<style>
  .group-dialog__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    white-space: pre-wrap;
  }

  .group-dialog__grid {
    display: grid;
    /* auto-fill with a 120px floor: six across in the widest dialog, two on a
       phone, with no breakpoint of its own. */
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member { text-align: center; }
  .member__media {
    position: relative;
    display: grid;
    place-items: center;
    /* 3:4, the proportion the cards and the other dialogs use, so the same
       photograph is not a different shape in two places. */
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 10px;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .member__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .member__monogram {
    color: rgba(255, 255, 255, 0.65);
    font-size: 28px;
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
  }
  .member__name {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.3;
  }
  .member__role {
    margin: 2px 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }
</style>
