---
// A body's or a squad's people, as GroupDialog and BodyGroupDialog show them:
// the remit (when there is one) above a grid of portraits. One component so the
// roster reads the same whichever dialog it is in.
interface Props {
  /** A body's remit, as the API sends it: plain text with newlines. */
  description?: string | null;
  people: {
    name: string; image: string | null; subtitle: string;
    /** The view (PersonView) a tap on the tile opens; unset = not openable. */
    view?: string;
    /** Set when the seat has a contact address: the tile shows an envelope. */
    email?: string | null;
  }[];
}
const { description = null, people } = Astro.props;

const MAIL_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>`;

const initials = (name: string) =>
  name.split(/\s+/).map((p) => p[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();
---
{/* `pre-wrap`, because the API sends plain text with newlines rather than
    markup: rendered as one block, four paragraphs run into a wall. */}
{description && <p class="group-dialog__desc">{description}</p>}

{/* A plain list where a person has nothing more to show. Where they do (a
    body's member: their profile, maybe an address), the tile is a BUTTON
    opening their view in this dialog. The photograph is decorative because
    the name is directly underneath it — alt text repeating it would have a
    screen reader read every person twice. */}
<ul class="group-dialog__grid">
  {people.map((p) => {
    const inner = (<>
      <span class="member__media">
        {p.image
          ? <img src={p.image} alt="" loading="lazy" width="160" height="213" />
          : <span class="member__monogram" aria-hidden="true">{initials(p.name)}</span>}
        {/* An envelope in the corner: this seat can be written to. The
            address itself is on the profile, where there is room for it. */}
        {p.email && <span class="member__mail" title="Kontakt e-mail" set:html={MAIL_ICON} />}
      </span>
      {/* Already abbreviated where the API decided it must be — a minor gets
          an abbreviated surname. Never expanded or re-joined here: the
          abbreviation IS the privacy control. */}
      <p class="member__name">{p.name}</p>
      {p.subtitle && <p class="member__role">{p.subtitle}</p>}
    </>);
    return (
      <li class="member">
        {p.view
          ? <button type="button" class="member__open" data-show-view={p.view}
                    aria-label={`${p.name}${p.email ? " — kontakt e-mail" : ""}`}>{inner}</button>
          : inner}
      </li>
    );
  })}
</ul>

<style>
  .group-dialog__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    white-space: pre-wrap;
  }

  .group-dialog__grid {
    display: grid;
    /* auto-fill with a 120px floor: six across in the widest dialog, two on a
       phone, with no breakpoint of its own. */
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member { text-align: center; }
  /* A tile you can open: the same tile, as a button that does not look like
     one, lifting like the cards do. */
  .member__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }
  .member__open:hover .member__name { color: var(--color-accent); }
  .member__open:hover .member__media { box-shadow: var(--shadow-paper); }
  .member__open:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 10px; }
  .member__mail {
    position: absolute;
    right: 6px;
    bottom: 6px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
  }
  .member__media {
    position: relative;
    display: grid;
    place-items: center;
    /* 3:4, the proportion the cards and the other dialogs use, so the same
       photograph is not a different shape in two places. */
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 10px;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .member__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .member__monogram {
    color: rgba(255, 255, 255, 0.65);
    font-size: 28px;
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
  }
  .member__name {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.3;
  }
  .member__role {
    margin: 2px 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }
</style>
