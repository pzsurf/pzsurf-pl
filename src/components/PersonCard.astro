---
import SocialIcon from "./SocialIcon.astro";
import type { TeamMember } from "../lib/api";

export interface DialogRow {
  /** Left of the row: a squad ("2026 — Longboard") or a body's name. */
  label: string;
  /** Right of the row: age categories, or a governance role. */
  detail: string;
}

interface Props {
  member: TeamMember;
  /** Under the name on the CARD. Categories for an athlete, role for a body
   *  member — whichever the section makes sense of. */
  subtitle?: string;
  /** Heading above the rows in the dialog: "Kadra narodowa" / "Władze". */
  group: string;
  /** Every membership of this KIND that this person holds. */
  rows: DialogRow[];
}
const { member, subtitle = "", group, rows } = Astro.props;

// Initials from whatever name we were given. Built from display_name rather
// than first/last, because those are not public fields — the API sends one
// already-formatted string and nothing else.
const initials = member.display_name
  .split(/\s+/).map((p) => p[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();
---
{/* A BUTTON, not an article with a click handler: it is focusable, it responds
    to Enter and Space, and it announces itself as something you can activate.
    The dialog it opens is one shared element — see PersonDialog. */}
<button
  type="button"
  class="card"
  data-person
  data-name={member.display_name}
  data-image={member.image_url ?? ""}
  data-initials={initials}
  data-group={group}
  data-rows={JSON.stringify(rows)}
>
  <div class="card__media">
    {member.image_url
      ? <img src={member.image_url} alt="" loading="lazy" width="320" height="320" />
      : <span class="card__monogram" aria-hidden="true">{initials}</span>}
  </div>
  {/* The person's own accounts, rendered at BUILD time inside a <template> and
      cloned into the dialog when this card opens it. A template is inert —
      nothing is shown, nothing is focusable, nothing is fetched — which is what
      makes it safe to carry on all 63 cards.
      Built here rather than assembled from SVG strings in the dialog's script
      because the icons are Astro components; and styled by a GLOBAL class
      rather than a scoped one, because a clone carries this component's
      data-astro-cid into a dialog that has a different one. */}
  {member.socials.length > 0 && (
    <template data-socials>
      {member.socials.map((s) => (
        <a class="person-social" href={s.url} target="_blank" rel="noopener noreferrer"
           aria-label={s.platform}>
          <SocialIcon platform={s.platform} />
        </a>
      ))}
    </template>
  )}

  <div class="card__body">
    <p class="card__name">{member.display_name}</p>
    {subtitle && <p class="card__cats">{subtitle}</p>}
  </div>
</button>

<style>
  .card {
    /* 186px is measured, not chosen: the longest name on the roster —
       "Maksymilian Michalewski" — is 160px at this size, plus 16px of padding,
       plus a little slack. Every name therefore sits on ONE line, which is what
       `white-space: nowrap` below enforces and what stops a card growing a
       second line and dragging its whole row taller. */
    width: 186px;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    scroll-snap-align: start;
    padding: 0;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .card:hover { border-color: var(--color-accent); }
  .card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    /* 3:4 against the 186px width. A definite height, never `aspect-ratio`:
       that left the grid track content-sized, so the image took its own height
       and the crop never happened. */
    height: 248px;
    flex: 0 0 auto;
    overflow: hidden;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .card__media img {
    /* Absolute, so the picture cannot resolve its height against an indefinite
       track and spill out of the box. */
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .card__monogram {
    color: rgba(255, 255, 255, 0.65);
    font-size: 52px;
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
  }

  .card__body {
    flex: 1 1 auto;
    padding: 10px var(--space-2);
    overflow: hidden;
  }
  .card__name {
    margin: 0;
    font-size: 13px;
    line-height: 1.3;
    font-weight: var(--weight-subhead);
    color: var(--color-text);
    /* One line, always. The ellipsis is a backstop for a name longer than any
       on today's roster, not the expected outcome. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card__cats {
    margin: var(--space-1) 0 0;
    color: var(--color-text-faint);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
