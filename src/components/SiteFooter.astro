---
import { primaryAddress, socialLinks, type Organisation } from "../lib/api";
import SocialIcon from "./SocialIcon.astro";
interface Props { org: Organisation }
const { org } = Astro.props;
const address = primaryAddress(org);
const socials = socialLinks(org);
// KRS, NIP and REGON on one line, each only when the record has it.
const registry = ([["KRS", org.krs], ["NIP", org.nip], ["REGON", org.regon]] as const)
  .filter(([, value]) => value)
  .map(([label, value]) => `${label} ${value}`)
  .join(" · ");
const account = org.bank_account ?? null;
---
<footer class="foot on-dark" id="kontakt">
  <div class="foot__inner">
    <div>
      <p class="foot__name">{org.name}</p>
      {address && <p class="foot__line">{address}</p>}
      {org.email && (
        <p class="foot__line"><a href={`mailto:${org.email}`}>{org.email}</a></p>
      )}
      {org.phone && <p class="foot__line">{org.phone}</p>}
      {registry && <p class="foot__line foot__registry">{registry}</p>}
      {account && (
        <p class="foot__line">
          Rachunek bankowy: <span class="foot__account">{account.iban_formatted}</span>
          {account.currency !== "PLN" && ` (${account.currency})`}
        </p>
      )}
    </div>

    <div class="foot__right">
      {socials.length > 0 && (
        <p class="foot__socials">
          {/* The label is what the icon means, so it is the accessible name.
              SocialIcon keys on it lowercased; an unplaced host gets the
              generic link glyph. */}
          {socials.map((s) => (
            <a class="person-social" href={s.url} target="_blank" rel="noopener noreferrer"
               aria-label={s.label} title={s.label}>
              <SocialIcon platform={s.label} />
            </a>
          ))}
        </p>
      )}
      {/* Said plainly rather than buried: this page is generated from the
          federation's own record on the platform, so the two cannot disagree. */}
      <p class="foot__line foot__credit">
        <a href="/deklaracja-dostepnosci/" target="_blank" rel="noopener">Deklaracja dostępności<span class="visually-hidden"> (otwiera się w nowej karcie)</span></a>
        ·
        <a href="/tekst-latwy-do-czytania/" target="_blank" rel="noopener">Tekst łatwy do czytania<span class="visually-hidden"> (otwiera się w nowej karcie)</span></a>
        ·
        <a href="/pliki-cookies/">Pliki cookies</a>
        ·
        Dane z platformy <a href="https://surfpoland.com">surfpoland.com</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: var(--space-7); padding-block: var(--space-5); }
  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  .foot__name {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .foot__line { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }
  .foot__registry { margin-top: var(--space-2); }
  /* Tabular figures so the groups line up, and never split mid-number: the
     account wraps below its label as a whole instead. */
  .foot__account { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .foot__right { text-align: right; }
  .foot__socials { display: flex; gap: var(--space-2); justify-content: flex-end; margin: 0 0 var(--space-3); }
  .foot a { color: inherit; }
  .foot a:hover { color: var(--color-accent); }
  /* The round button itself is the global .person-social; `.foot a` above
     outranks its muted colour, so it is restated here. Hover still wins. */
  .foot__socials a { color: var(--color-text-muted); }
  .foot__credit { margin-top: var(--space-2); color: var(--color-text-faint); font-size: var(--text-xs); }

  @media (max-width: 560px) {
    .foot__right, .foot__socials { text-align: left; justify-content: flex-start; }
  }
</style>
