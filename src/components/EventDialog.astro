---
// ONE event's details, in its own dialog. Opened by its EventCard, and by its
// row in the "wszystkie wydarzenia" list.
//
// **Why the card stopped being a link.** It used to go straight out to the
// event's own site, which meant the only way to find out what an event WAS
// involved leaving the page — and coming back to a federation calendar you had
// lost your place in. Everything the API will tell us about an event is a few
// fields, so the dialog can simply say them, and then offer the way out to
// anybody who wants the entry form. That is the same bargain OrgCard struck
// with OrgDialog for the affiliated clubs.
//
// A dialog PER event, rendered at build time with its details inside it, for
// the two reasons every other dialog here is: the description stays in the
// document for crawlers and link previews, and there is nothing to assemble at
// runtime beyond `showModal()`.
//
// The shell comes from `.person` in tokens.css, as the others' do: Astro scopes
// styles per component, so a look two dialogs share has to live in the global
// stylesheet or the second one silently gets none of it.
import type { PublicOrgEvent } from "../lib/api";
import { eventDates, eventTypeLabel, isPastEvent } from "../lib/api";

interface Props {
  /** Matches the `dialogId` of the card and the row that open it. */
  id: string;
  event: PublicOrgEvent;
}
const { id, event } = Astro.props;

const past = isPastEvent(event);

// Under the name: what kind of thing it is, when, and where. Each part is
// optional, so the line is built from what is actually there rather than
// printing "—" for what the API did not send.
const metaParts = [
  eventTypeLabel(event.event_type),
  eventDates(event),
  ...(event.location_name ? [event.location_name] : []),
].filter(Boolean);

// Its own site, where it has one. There is no fallback to the event's page on
// surfpoland.com any more (the federation's choice, September 2026: the page
// no longer sends readers to the platform), so an event without a site of its
// own simply has no link.
---
<dialog
  class="person event-dialog"
  id={id}
  data-event-dialog
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close dialog-close" aria-label="Zamknij">×</button>
  </form>

  {/* Decorative: the name is right beneath it and an alt repeating the name is
      read twice by a screen reader. */}
  {event.image_url && (
    <span class="event-dialog__media" aria-hidden="true">
      <img src={event.image_url} alt="" loading="lazy" width="640" height="360" />
    </span>
  )}

  {/* ONE padded box for the head and the text below it, so the meta line and
      the description share an edge. They used to sit in two containers with
      two paddings — the shell's and the scroller's — and the description was
      indented past the line above it. */}
  <div class="event-dialog__body">
    <div class="person__head event-dialog__head">
      <h2 class="person__name dialog-title" id={`${id}-title`}>{event.name}</h2>
      {(metaParts.length > 0 || past) && (
        <p class="event-dialog__meta">
          {metaParts.map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{part}</span>
            </>
          ))}
          {/* On the meta line rather than under it: it is one more fact about
              when this event is. Said in words at all because the greyed-out
              card it was opened from is not in view here, and nothing else in
              the dialog would say it. */}
          {past && <span class="event-dialog__past">Wydarzenie zakończone</span>}
        </p>
      )}
    </div>

    {/* `pre-wrap`, because the API sends plain text carrying its own newlines:
        rendered as one block, four paragraphs run into a wall. The same
        treatment OrgDialog gives a club's blurb. */}
    {event.description
      ? <p class="event-dialog__about">{event.description}</p>
      : <p class="event-dialog__empty">Opis tego wydarzenia nie został opublikowany.</p>}

    {event.external_url && (
      <a
        class="event-dialog__more"
        href={event.external_url}
        target="_blank"
        rel="noopener noreferrer"
      >
        Strona wydarzenia
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" />
        </svg>
      </a>
    )}
  </div>
</dialog>

<style>
  .event-dialog {
    width: min(640px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       retracted, so a 100vh-tall dialog is taller than what can be seen. */
    max-height: calc(100svh - var(--space-4) * 2);
    /* THE WHOLE DIALOG SCROLLS, not a pane inside it. With only the text
       scrolling, the picture was pinned above it and a long description had to
       fit in whatever was left — a few lines on a phone. Scrolling everything
       means the frame arrives whole and the reader pushes it out of the way
       themselves. */
    overflow-y: auto;
    /* The shell's padding moves onto `__body` below, so the picture can run to
       the dialog's own edges instead of sitting in an inset box. */
    padding: 0;
  }

  /* The close button is positioned against the dialog, so in a scrolling
     dialog it scrolls away with the content — it has to stay reachable. A
     zero-height sticky strip holds it at the top without taking any room in
     the flow, so the picture still starts at the very top edge. */
  .event-dialog .person__close-form {
    position: sticky;
    top: 0;
    z-index: 2;
    height: 0;
  }

  /* Across the top of the dialog, which is where a banner belongs — the
     platform renders the same picture wide on the event's own page. */
  .event-dialog__media {
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
    border-radius: 12px 12px 0 0;   /* matches .person's own corner radius */
  }
  .event-dialog__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* The ONE padding in the dialog, so every line under the picture starts at
     the same edge. */
  .event-dialog__body { padding: var(--space-4); }

  /* Left, not centred. `.person__head` centres itself for a roster portrait;
     here the meta line and the description below it are left-aligned prose, and
     a centred title over them made the block look like two different cards. */
  .event-dialog__head {
    padding: 0;
    padding-bottom: var(--space-3);
    text-align: left;
  }
  /* With no picture the title is the first thing in the dialog, level with
     the ×; keep a lane clear on its right so a long name wraps short of it. */
  .event-dialog:not(:has(.event-dialog__media)) .event-dialog__head { padding-right: var(--space-5); }

  .event-dialog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  /* On the same line as the dates, but not as one more dot-separated fact of
     the same kind — it is a verdict on all of them, so it carries its own
     shape. */
  .event-dialog__past {
    margin-left: var(--space-1);
    /* The same outlined pill an organisation's disciplines get, so a small
       capsule means the same thing in both dialogs. */
    padding: 2px 10px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .event-dialog__about {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-base);
    white-space: pre-wrap;
  }
  .event-dialog__empty {
    margin: 0;
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .event-dialog__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-4);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    text-decoration: none;
  }
  .event-dialog__more:hover { text-decoration: underline; }
</style>

<script>
  // Card → dialog, row → dialog, and backdrop → close. The same wiring
  // OrgDialog uses; Astro hoists and de-dupes the module, so it runs once
  // however many events are on the page.
  for (const opener of document.querySelectorAll<HTMLElement>("[data-open-event]")) {
    opener.addEventListener("click", () => {
      const id = opener.dataset.openEvent;
      const dialog = id ? document.getElementById(id) : null;
      if (!(dialog instanceof HTMLDialogElement)) return;
      // An opener can itself be a row INSIDE the "wszystkie wydarzenia" dialog,
      // and two modals at once is not a thing worth having: `showModal()`
      // throws on an already-open dialog, and a stack would have to be unwound
      // one Escape at a time. So whatever opened this closes first.
      opener.closest("dialog")?.close();
      dialog.showModal();
    });
  }

  // Click outside to close. A dialog element covers the whole viewport
  // including its backdrop, so a click landing on IT rather than on its
  // contents is a click on the backdrop.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-event-dialog]")) {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
