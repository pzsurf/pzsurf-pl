---
// A GROUP of bodies the federation presents together ("Komisje zadaniowe"),
// in one dialog: first the list of its bodies, and a tap on one shows that
// body's roster IN THE SAME DIALOG, with a back arrow in the top-left corner
// to return to the list and the usual × to close.
//
// Every view is rendered at build time, like every other dialog here — the
// list and each body's roster are real markup in the document, so crawlers and
// link previews read every name. The script only decides which one is showing;
// with no JavaScript the list shows and a row does nothing, which is the
// honest way for it to fail (each body is still in the page source).

import Roster from "./Roster.astro";
import PersonView, { type PersonProfile } from "./PersonView.astro";
import { counted, headcount } from "../lib/plural";

interface Props {
  /** Matches the `dialogId` of the card that opens it. */
  id: string;
  title: string;
  bodies: {
    name: string;
    /** Ahead of the headcount in the body's meta line: its kind. */
    meta: string[];
    count: number;
    description?: string | null;
    people: { name: string; image: string | null; subtitle: string; view?: string; email?: string | null }[];
    /** Its members as profiles, opened from their tiles (back to this body). */
    profiles?: PersonProfile[];
  }[];
}
const { id, title, bodies } = Astro.props;

const viewId = (i: number) => `${id}-organ-${i + 1}`;

const CHEVRON_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>`;
// The same arrow BackButton draws on the subpages.
const BACK_ICON = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M19 12H5M11 18l-6-6 6-6" /></svg>`;
---
<dialog
  class="person body-group"
  id={id}
  data-group-dialog
  data-views
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    <button class="person__close dialog-close" aria-label="Zamknij">×</button>
  </form>

  {/* The list: one row per body. A BUTTON, not a link — a body has no page of
      its own to go to; it is shown here, in this dialog. */}
  <section class="body-group__view" data-view={`${id}-list`}>
    <div class="person__head">
      <h2 class="person__name dialog-title" id={`${id}-title`}>{title}</h2>
      <p class="body-group__meta">{counted(bodies.length, ["organ", "organy", "organów"])}</p>
    </div>
    <ul class="body-group__list" data-view-scroll>
      {bodies.map((b, i) => (
        <li>
          <button type="button" class="body-row" data-show-view={viewId(i)}>
            <span class="body-row__text">
              <span class="body-row__title">{b.name}</span>
              <span class="body-row__foot">{headcount(b.count)}</span>
            </span>
            <span class="body-row__action" set:html={CHEVRON_ICON} />
          </button>
        </li>
      ))}
    </ul>
  </section>

  {/* A view per body: its name, kind and headcount, then its roster. */}
  {bodies.map((b, i) => (
    <section class="body-group__view" data-view={viewId(i)} aria-labelledby={`${viewId(i)}-title`} hidden>
      <button type="button" class="dialog-close body-group__back" data-show-view={`${id}-list`}
              aria-label="Wstecz" set:html={BACK_ICON} />
      <div class="person__head">
        <h2 class="person__name dialog-title" id={`${viewId(i)}-title`}>{b.name}</h2>
        <p class="body-group__meta">
          {[...b.meta, headcount(b.count)].map((part, j) => (
            <>
              {j > 0 && <span aria-hidden="true">·</span>}
              <span>{part}</span>
            </>
          ))}
        </p>
      </div>
      <div class="body-group__scroll" data-view-scroll>
        <Roster description={b.description} people={b.people} />
      </div>
    </section>
  ))}
  {bodies.flatMap((b, i) => (b.profiles ?? []).map((p) => <PersonView profile={p} back={viewId(i)} />))}
</dialog>

<style>
  /* The shell, head, × and backdrop come from tokens.css. As wide as a body's
     own dialog (GroupDialog), since a view here IS a body's roster. */
  .body-group {
    width: min(880px, calc(100vw - 32px));
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, never the bare class: a closed dialog must stay display: none. */
  .body-group[open] {
    display: flex;
    flex-direction: column;
  }
  .body-group__view:not([hidden]) {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1 1 auto;
  }
  .body-group .person__head { flex: none; }

  /* The way back to the list: the ×'s disc, mirrored into the other corner. */
  .body-group__back {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 2;
    cursor: pointer;
  }

  .body-group__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  .body-group__scroll {
    flex: 1 1 auto;
    overflow-y: auto;
    margin-top: var(--space-4);
  }

  .body-group__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    flex: 1 1 auto;
    overflow-y: auto;
  }

  /* A row as the document shelves draw theirs (ShelfDialog `.docrow`), so a
     list in a dialog looks like one list wherever it is. */
  .body-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .body-row:hover {
    box-shadow: var(--shadow-paper);
    background: var(--color-bg-raised);
  }
  .body-row:hover .body-row__title { color: var(--color-accent); }
  .body-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .body-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .body-row__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.35;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
  .body-row__foot {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }
  .body-row__action {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--color-text-faint);
  }
</style>

<script>
  // Which view shows: the list, a body, a person (lib/dialogViews.ts).
  // Opening and closing are GroupDialog's shared script.
  import { bindDialogViews } from "../lib/dialogViews";
  bindDialogViews();
</script>
