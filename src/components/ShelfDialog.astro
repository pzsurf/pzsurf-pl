---
// One shelf of documents, as a list of rows in its own dialog. Opened by the
// matching GroupCard, the same way a squad's or a komisja's roster is.
//
// A ROW IS A LINK, and that is the whole point of the shape: a document has an
// address, so middle-clicking it, copying it, or sharing it all work, and it
// opens in a tab of its own rather than in a viewer this page would have to
// build. A button could do none of that.
//
// Rendered at build time with its rows inside it, like every other dialog here:
// the titles stay in the document for crawlers and link previews, and nothing
// is assembled at runtime.

interface Props {
  /** Matches the `dialogId` of the card that opens it. */
  id: string;
  title: string;
  count: number;
  rows: {
    title: string;
    /** Small, above the title: a date, or an uchwała's number. */
    eyebrow?: string | null;
    /** Small, below: the file name, or which meeting adopted it. */
    footnote?: string | null;
    /** Where the row goes. Always a real address — see the note above. */
    href: string;
    /** This site's own page rather than a file elsewhere, so it opens in this
     *  tab like any other link here. A document keeps the new tab: it is a PDF
     *  somebody is fetching, not a page they are reading on. */
    sameTab?: boolean;
  }[];
  /** Draw the eyebrow as an IDENTIFIER in the accent colour rather than as
   *  faint small print. True for uchwały, whose eyebrow is the number they are
   *  cited by; false for the file shelves, whose eyebrow is a date and has no
   *  business shouting. */
  accentEyebrow?: boolean;
  /** `[mianownik, 2–4, 5+]` for whatever these rows are. See `counted`. */
  countForms?: [string, string, string];
}
const {
  id, title, count, rows, accentEyebrow = false,
  countForms = ["dokument", "dokumenty", "dokumentów"],
} = Astro.props;

// Polish counts three ways and the forms are irregular, so they are GIVEN
// rather than derived: 1 dokument / 2 dokumenty / 5 dokumentów, but
// 1 ogłoszenie / 2 ogłoszenia / 5 ogłoszeń. Deriving the second from the first
// is a grammar engine nobody here needs.
function counted(n: number): string {
  const [one, few, many] = countForms;
  if (n === 1) return `1 ${one}`;
  const ten = n % 10;
  const hundred = n % 100;
  const isFew = ten >= 2 && ten <= 4 && (hundred < 10 || hundred >= 20);
  return `${n} ${isFew ? few : many}`;
}

const EXTERNAL_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>`;
// A row that stays on this site gets a chevron, not the arrow that means "this
// leaves the page". The icon is the only thing telling the two apart, so it has
// to tell the truth.
const CHEVRON_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>`;
---
<dialog
  class="person shelf-dialog"
  id={id}
  data-group-dialog
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <h2 class="person__name" id={`${id}-title`}>{title}</h2>
    <p class="shelf-dialog__meta">{counted(count)}</p>
  </div>

  <ul class="shelf-dialog__list">
    {rows.map((row) => (
      <li>
        {/* A file elsewhere opens in its own tab; a page on THIS site opens in
            this one, the way every other link here behaves. `rel="noopener"` is
            not optional with target=_blank — without it the opened tab gets a
            handle on this page through window.opener. */}
        <a class="docrow" href={row.href}
           {...(row.sameTab ? {} : { target: "_blank", rel: "noopener noreferrer" })}>
          <span class="docrow__text">
            {row.eyebrow && (
              <span class:list={["docrow__eyebrow", { "docrow__eyebrow--accent": accentEyebrow }]}>
                {row.eyebrow}
              </span>
            )}
            <span class="docrow__title">{row.title}</span>
            {row.footnote && <span class="docrow__foot">{row.footnote}</span>}
          </span>
          <span class="docrow__action" set:html={row.sameTab ? CHEVRON_ICON : EXTERNAL_ICON} />
        </a>
      </li>
    ))}
  </ul>
</dialog>

<style>
  /* The shell, head, close button and backdrop come from tokens.css, which every
     dialog on this page shares. Only what is different about a SHELF is here. */
  .shelf-dialog {
    width: min(680px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       retracted, so a 100vh-tall dialog is taller than what can be seen. */
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, NEVER the bare class: the UA stylesheet hides a closed dialog with
     `display: none`, and an unqualified `display: flex` would beat it. */
  .shelf-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .shelf-dialog .person__head { flex: none; }
  .shelf-dialog__meta {
    margin: var(--space-2) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  .shelf-dialog__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    /* Only the list scrolls; the shelf's name stays put above it. */
    flex: 1 1 auto;
    overflow-y: auto;
  }

  /* A row, and it has to survive a phone. The text column takes the space and
     WRAPS — nothing is truncated, because a document's title is the only thing
     telling you what it is — while the icon keeps its own column at the end.
     `min-height: 48px` keeps the tap target above the 44px floor even for a
     one-line row. */
  .docrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }
  .docrow:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-raised);
  }
  .docrow:hover .docrow__title { color: var(--color-accent); }
  .docrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .docrow__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    /* `min-width: 0` is what lets a long file name wrap instead of forcing the
       row wider than the dialog — the classic flex overflow. */
    min-width: 0;
    flex: 1 1 auto;
  }
  .docrow__eyebrow,
  .docrow__foot {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    /* A file name has no spaces to break at, so it is allowed to break
       anywhere rather than push the row sideways. */
    overflow-wrap: anywhere;
  }
  /* An uchwała's number is its NAME, so it leads the row in the accent rather
     than sitting above the title as grey small print — the same move the
     uchwała's own page makes.
     `accent-strong` here, not `accent`: on the page the number is 20px at
     display weight, which counts as large text and clears 3:1 with the base
     red. In a row it is normal-size text needing 4.5:1, which the base red
     misses on this light ground and the strong red carries. Dialogs never sit
     inside an `.on-dark` band, so there is no dark ground to answer for. */
  .docrow__eyebrow--accent {
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docrow__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.35;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
  .docrow__action {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--color-text-faint);
  }
  .docrow:hover .docrow__action { color: var(--color-accent); }
</style>

<script>
  // Opening and closing, for every card and dialog on the page — the shelves
  // here and the rosters in GroupDialog alike, since both use the same two
  // attributes.
  //
  // GUARDED, because that component ships the identical script: Astro hoists
  // each component's script once, so both would run and the second
  // `showModal()` on an already-open dialog would throw. First one in wins.
  if (!window.__pzsurfDialogsBound) {
    window.__pzsurfDialogsBound = true;

    for (const card of document.querySelectorAll<HTMLElement>("[data-open-group]")) {
      card.addEventListener("click", () => {
        const id = card.dataset.openGroup;
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    }

    // Click outside to close. A dialog element covers the whole viewport
    // including its backdrop, so a click landing on IT rather than on its
    // contents is a click on the backdrop.
    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-group-dialog]")) {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }
</script>
