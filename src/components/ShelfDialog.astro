---
// One shelf of documents, as a list of rows in its own dialog. Opened by the
// matching GroupCard, the same way a squad's or a komisja's roster is.
//
// A ROW IS A LINK, and that is the whole point of the shape: a document has an
// address, so middle-clicking it, copying it, or sharing it all work, and it
// opens in a tab of its own rather than in a viewer this page would have to
// build. A button could do none of that.
//
// Rendered at build time with its rows inside it, like every other dialog here:
// the titles stay in the document for crawlers and link previews, and nothing
// is assembled at runtime.

interface Props {
  /** Matches the `dialogId` of the card that opens it. */
  id: string;
  title: string;
  count: number;
  rows: {
    title: string;
    /** Small, above the title: a date, or an uchwała's number. */
    eyebrow?: string | null;
    /** Small, below: the file name, or which meeting adopted it. */
    footnote?: string | null;
    /** Where the row goes. Always a real address — see the note above.
     *  Omitted only when `opens` names a dialog instead. */
    href?: string;
    /** The id of a dialog this row opens, INSTEAD of going anywhere.
     *
     *  For a row whose subject has no address to go to: an event's details live
     *  in a dialog on this page, not on a page of its own, so a link would have
     *  nowhere honest to point. Everything else here — a document, an uchwała,
     *  an ogłoszenie — has a real URL and keeps it, which is the whole reason
     *  this shape is a list of links. */
    opens?: string;
    /** This site's own page rather than a file elsewhere, so it opens in this
     *  tab like any other link here. A document keeps the new tab: it is a PDF
     *  somebody is fetching, not a page they are reading on. */
    sameTab?: boolean;
    /** A picture for the row, shown as a thumbnail on its left. Only drawn
     *  when the shelf asks for `thumbnails`; null there draws the placeholder,
     *  so every row in the list keeps the same shape. */
    thumb?: string | null;
  }[];
  /** Draw the eyebrow as an IDENTIFIER in the accent colour rather than as
   *  faint small print. True for uchwały, whose eyebrow is the number they are
   *  cited by; false for the file shelves, whose eyebrow is a date and has no
   *  business shouting. */
  accentEyebrow?: boolean;
  /** `[mianownik, 2–4, 5+]` for whatever these rows are. See `counted`. */
  countForms?: [string, string, string];
  /** Show this many rows first, and the next as many each time the reader
   *  scrolls near the end of the list. Unset: one long list, as every shelf
   *  was before. Every row is still RENDERED for the reason at the top of this
   *  file; the script only holds the later ones back until they are scrolled
   *  to. With no JavaScript the whole list shows, which is a fine way for a
   *  list to fail. */
  batchSize?: number;
  /** Give every row a thumbnail on the left: its `thumb`, or a placeholder
   *  tile where it has none. For a list of things that have pictures (the
   *  announcements), not for a shelf of files. */
  thumbnails?: boolean;
}
import { counted as countedPl, type CountForms } from "../lib/plural";

const {
  id, title, count, rows, accentEyebrow = false,
  countForms = ["dokument", "dokumenty", "dokumentów"],
  batchSize,
  thumbnails = false,
} = Astro.props;
const batched = !!batchSize && rows.length > batchSize;

// Polish plural forms: see lib/plural.ts.
const counted = (n: number) => countedPl(n, countForms as CountForms);

const EXTERNAL_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>`;
// A row that stays on this site gets a chevron, not the arrow that means "this
// leaves the page". The icon is the only thing telling the two apart, so it has
// to tell the truth.
// The same megaphone AnnouncementCard draws for a notice with no picture.
const MEGAPHONE_ICON = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M3 11l18-5v12L3 15v-4z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`;
const CHEVRON_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>`;
---
<dialog
  class="person shelf-dialog"
  id={id}
  data-group-dialog
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <h2 class="person__name" id={`${id}-title`}>{title}</h2>
    <p class="shelf-dialog__meta">{counted(count)}</p>
  </div>

  <ul class="shelf-dialog__list" data-shelf-batch={batched ? batchSize : undefined}>
    {rows.map((row) => (
      <li data-shelf-row>
        {/* The same row twice, as the element its destination deserves: an
            anchor where there is an address, a button where the subject only
            has a dialog. Not one element with a click handler — that would take
            middle-click, cmd-click and copy-link away from the rows that do
            have addresses, which is most of them.

            A file elsewhere opens in its own tab; a page on THIS site opens in
            this one, the way every other link here behaves. `rel="noopener"` is
            not optional with target=_blank — without it the opened tab gets a
            handle on this page through window.opener. */}
        {row.opens ? (
          <button type="button" class="docrow" data-open-event={row.opens}
                  aria-haspopup="dialog">
            <span class="docrow__text">
              {row.eyebrow && (
                <span class:list={["docrow__eyebrow", { "docrow__eyebrow--accent": accentEyebrow }]}>
                  {row.eyebrow}
                </span>
              )}
              <span class="docrow__title">{row.title}</span>
              {row.footnote && <span class="docrow__foot">{row.footnote}</span>}
            </span>
            <span class="docrow__action" set:html={CHEVRON_ICON} />
          </button>
        ) : (
          <a class="docrow" href={row.href}
             {...(row.sameTab ? {} : { target: "_blank", rel: "noopener noreferrer" })}>
            {thumbnails && (
              <span class="docrow__thumb">
                {/* Decorative: the title beside it already says what the row
                    is, so the picture adds nothing a screen reader needs. */}
                {row.thumb
                  ? <img src={row.thumb} alt="" loading="lazy" width="96" height="54" />
                  : <span class="docrow__thumb-mono" set:html={MEGAPHONE_ICON} />}
              </span>
            )}
            <span class="docrow__text">
              {row.eyebrow && (
                <span class:list={["docrow__eyebrow", { "docrow__eyebrow--accent": accentEyebrow }]}>
                  {row.eyebrow}
                </span>
              )}
              <span class="docrow__title">{row.title}</span>
              {row.footnote && <span class="docrow__foot">{row.footnote}</span>}
            </span>
            <span class="docrow__action" set:html={row.sameTab ? CHEVRON_ICON : EXTERNAL_ICON} />
          </a>
        )}
      </li>
    ))}
    {/* Watched by the script: when it scrolls into view, the next rows are
        shown. Hidden until then, so without JavaScript it is never drawn. */}
    {batched && <li class="shelf-dialog__more" data-shelf-more aria-hidden="true" hidden />}
  </ul>

</dialog>

<style>
  /* The shell, head, close button and backdrop come from tokens.css, which every
     dialog on this page shares. Only what is different about a SHELF is here. */
  .shelf-dialog {
    width: min(680px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       retracted, so a 100vh-tall dialog is taller than what can be seen. */
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, NEVER the bare class: the UA stylesheet hides a closed dialog with
     `display: none`, and an unqualified `display: flex` would beat it. */
  .shelf-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .shelf-dialog .person__head { flex: none; }
  .shelf-dialog__meta {
    margin: var(--space-2) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  .shelf-dialog__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    /* Only the list scrolls; the shelf's name stays put above it. */
    flex: 1 1 auto;
    overflow-y: auto;
  }

  /* A row, and it has to survive a phone. The text column takes the space and
     WRAPS — nothing is truncated, because a document's title is the only thing
     telling you what it is — while the icon keeps its own column at the end.
     `min-height: 48px` keeps the tap target above the 44px floor even for a
     one-line row. */
  /* One rule for both elements a row can be — see the note in the markup. The
     four declarations after `text-decoration` are what a <button> needs to stop
     looking like one; they are inert on an <a>. */
  .docrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    width: 100%;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .docrow:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-raised);
  }
  .docrow:hover .docrow__title { color: var(--color-accent); }
  .docrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .docrow__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    /* `min-width: 0` is what lets a long file name wrap instead of forcing the
       row wider than the dialog — the classic flex overflow. */
    min-width: 0;
    flex: 1 1 auto;
  }
  .docrow__eyebrow,
  .docrow__foot {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    /* A file name has no spaces to break at, so it is allowed to break
       anywhere rather than push the row sideways. */
    overflow-wrap: anywhere;
  }
  /* An uchwała's number is its NAME, so it leads the row in the accent rather
     than sitting above the title as grey small print — the same move the
     uchwała's own page makes.
     `accent-strong` here, not `accent`: on the page the number is 20px at
     display weight, which counts as large text and clears 3:1 with the base
     red. In a row it is normal-size text needing 4.5:1, which the base red
     misses on this light ground and the strong red carries. Dialogs never sit
     inside an `.on-dark` band, so there is no dark ground to answer for. */
  .docrow__eyebrow--accent {
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .docrow__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.35;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
  .docrow__action {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--color-text-faint);
  }
  .docrow:hover .docrow__action { color: var(--color-accent); }

  /* A thumbnail at the carousel card's own 16:9, so a row and its card are
     recognisably the same notice. A definite box, never aspect-ratio alone:
     the picture must not be able to size its own row. */
  .docrow__thumb {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 96px;
    height: 54px;
    overflow: hidden;
    border-radius: calc(var(--radius) / 2);
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .docrow__thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .docrow__thumb-mono { display: grid; color: rgba(255, 255, 255, 0.55); }
  /* A phone: smaller, so the title keeps most of a 390px-wide row. */
  @media (max-width: 480px) {
    .docrow__thumb { width: 72px; height: 40px; }
  }

  /* The end-of-list marker the script watches. A few pixels, not zero: an
     element with no height can be skipped over by a fast scroll. */
  .shelf-dialog__more { height: 4px; flex: none; }
</style>

<script>
  // Opening and closing, for every card and dialog on the page — the shelves
  // here and the rosters in GroupDialog alike, since both use the same two
  // attributes.
  //
  // GUARDED, because that component ships the identical script: Astro hoists
  // each component's script once, so both would run and the second
  // `showModal()` on an already-open dialog would throw. First one in wins.
  if (!window.__pzsurfDialogsBound) {
    window.__pzsurfDialogsBound = true;

    for (const card of document.querySelectorAll<HTMLElement>("[data-open-group]")) {
      card.addEventListener("click", () => {
        const id = card.dataset.openGroup;
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    }

    // Click outside to close. A dialog element covers the whole viewport
    // including its backdrop, so a click landing on IT rather than on its
    // contents is a click on the backdrop.
    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-group-dialog]")) {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }

  // Load-on-scroll, for a shelf given `batchSize`. Outside the guard above:
  // that code is shared with GroupDialog, this is the shelf's own, and Astro
  // hoists a component's script once however many shelves the page has, so it
  // runs once and binds every batched list it finds.
  for (const list of document.querySelectorAll<HTMLElement>("[data-shelf-batch]")) {
    const dialog = list.closest("dialog");
    const more = list.querySelector<HTMLElement>("[data-shelf-more]");
    if (!dialog || !more) continue;
    const rows = [...list.querySelectorAll<HTMLElement>("[data-shelf-row]")];
    const batch = Number(list.dataset.shelfBatch);
    let shown = 0;

    const reveal = (count: number) => {
      shown = Math.min(count, rows.length);
      rows.forEach((row, i) => { row.hidden = i >= shown; });
      more.hidden = shown >= rows.length;
    };
    // The LIST is the scroller (the head stays put above it), so it is the
    // observer's root. The margin loads the next rows a little before the end
    // is reached, so a steady scroll never hits a wall. If a batch does not
    // fill the list, the marker is still in view and the next one follows at
    // once, until the list overflows or runs out.
    //
    // That last case needs `rearm`: an observer only reports a CHANGE, so a
    // marker that stays in view after a batch would never be reported again
    // and loading would stall with the list half full. Observing it afresh
    // makes the observer report its current state once more.
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting) && shown < rows.length) {
        reveal(shown + batch);
        rearm();
      }
    }, { root: list, rootMargin: "0px 0px 120px 0px" });
    const rearm = () => {
      observer.unobserve(more);
      if (shown < rows.length) observer.observe(more);
    };

    // Every opening starts from the top with the first rows only. Done on
    // OPEN, not on close: a closed dialog is display:none, and a browser
    // ignores scrollTop on an element that is not rendered, so a reset on
    // close left the list scrolled down, the marker in view, and every row
    // reloaded at once. There is no "open" event, so watch the attribute.
    new MutationObserver(() => {
      if (!dialog.open) return;
      reveal(batch);
      list.scrollTop = 0;
      rearm();
    }).observe(dialog, { attributes: true, attributeFilter: ["open"] });
    reveal(batch);
    rearm();
  }
</script>
