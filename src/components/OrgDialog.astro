---
// ONE affiliated organisation's details, in its own dialog. Opened by its
// OrgCard.
//
// A dialog PER organisation, rendered at build time with its details inside it
// — the same choice GroupDialog makes and for the same two reasons: every name,
// blurb and contact stays in the document as written, so crawlers and link
// previews read the whole register; and there is nothing to build at runtime,
// so a dozen dialogs of real markup cost a few kilobytes and no JavaScript
// beyond `showModal()`.
//
// NO SECTION HEADINGS. Each block says what it is by its own shape — pills are
// disciplines, prose is the blurb, a mail address is a mail address — and a
// stack of uppercase labels over three short blocks was more furniture than
// content. What the dialog does NOT show is the licences: which credentials a
// club holds from the federation is administration, not something a visitor
// came for, and it filled a third of the dialog with dates.
//
// The shell comes from `.person` in tokens.css, as GroupDialog's does: Astro
// scopes styles per component, so a look two dialogs share has to live in the
// global stylesheet or the second one silently gets none of it.

import { disciplineLabel, orgTypeLabel, primaryAddress, socialLinks, type Organisation } from "../lib/api";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  /** Matches the `dialogId` of the card that opens it. */
  id: string;
  org: Organisation;
}
const { id, org } = Astro.props;

const initial = (org.name.trim()[0] ?? "?").toUpperCase();

// Under the name: what it is, and where. Both optional — a club with neither
// still opens and still shows its blurb, so the line is built from whatever is
// actually there and omitted when that is nothing.
const metaParts = [
  ...org.types.map(orgTypeLabel),
  ...(org.city ? [org.city] : []),
];

// The street address is worth more than the locality already on the meta line,
// but only when it says something that line does not.
const address = primaryAddress(org);
const showAddress = Boolean(address && address !== org.city);

const hasContact = Boolean(org.email || org.phone || org.website_url || showAddress);
// De-duplicated, with the platform read off the URL rather than trusted from
// the record (see socialLinks), exactly as the footer lists the federation's.
const socials = socialLinks(org);
---
<dialog
  class="person org-dialog"
  id={id}
  data-org-dialog
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close dialog-close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head org-dialog__head">
    <span class="org-dialog__crest" aria-hidden="true">
      {org.image_url
        ? <img src={org.image_url} alt="" width="160" height="160" />
        : <span class="org-dialog__initial">{initial}</span>}
    </span>
    <div class="org-dialog__heading">
      <h2 class="person__name dialog-title" id={`${id}-title`}>{org.name}</h2>
      {metaParts.length > 0 && (
        <p class="org-dialog__meta">
          {metaParts.map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{part}</span>
            </>
          ))}
        </p>
      )}
    </div>
  </div>

  <div class="org-dialog__scroll">
    {org.disciplines.length > 0 && (
      <ul class="org-dialog__tags">
        {org.disciplines.map((d) => <li class="org-dialog__tag">{disciplineLabel(d)}</li>)}
      </ul>
    )}

    {/* `pre-wrap`, because the API sends plain text with newlines rather than
        markup: rendered as one block, four paragraphs run into a wall. The
        same treatment GroupDialog gives a body's remit. */}
    {org.description && <p class="org-dialog__about">{org.description}</p>}

    {hasContact && (
      <ul class="org-dialog__contact">
        {showAddress && <li class="org-dialog__contact-row">{address}</li>}
        {org.email && (
          <li class="org-dialog__contact-row">
            <a href={`mailto:${org.email}`}>{org.email}</a>
          </li>
        )}
        {/* `tel:` with the spacing stripped — a dialler cannot read
            "(+48) 791 163 902", but a person can, so the text keeps it and the
            href does not. */}
        {org.phone && (
          <li class="org-dialog__contact-row">
            <a href={`tel:${org.phone.replace(/[^\d+]/g, "")}`}>{org.phone}</a>
          </li>
        )}
        {org.website_url && (
          <li class="org-dialog__contact-row">
            <a href={org.website_url} target="_blank" rel="noopener noreferrer">
              {org.website_url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
            </a>
          </li>
        )}
      </ul>
    )}

    {/* Its own social accounts, where the link to its record on surfpoland.com
        used to be (the federation's choice, September 2026: the page no longer
        sends readers to the platform). The same round buttons as the footer
        and the roster cards (.person-social in tokens.css); the icon is the
        label, so the label is the accessible name. None, nothing drawn. */}
    {socials.length > 0 && (
      <p class="org-dialog__socials">
        {socials.map((s) => (
          <a class="person-social" href={s.url} target="_blank" rel="noopener noreferrer"
             aria-label={s.label} title={s.label}>
            <SocialIcon platform={s.label} />
          </a>
        ))}
      </p>
    )}
  </div>
</dialog>

<style>
  .org-dialog {
    width: min(640px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       retracted, so a 100vh-tall dialog is taller than what can be seen. */
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, NEVER the bare class: the UA stylesheet hides a closed dialog
     with `display: none`, and an unqualified `display: flex` would override it
     and leave the dialog permanently on the page. */
  .org-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  /* The crest and name stay put while the rest scrolls under them.
     `text-align: left` undoes `.person__head`'s centring from tokens.css: that
     is right for a dialog whose head is one centred portrait, and wrong for
     this one, where the crest sits to the LEFT and a centred name beside it
     reads as two things that were never aligned to each other. */
  .org-dialog__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
    padding-right: var(--space-5);   /* clear of the close button */
    text-align: left;
  }
  .org-dialog__heading { min-width: 0; }

  /* No ground of its own, matching the card: the dialog is light too, so a
     tint only drew a grey box around the logos that carry their own white. */
  .org-dialog__crest {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    flex: 0 0 auto;
    padding: 8px;
    box-sizing: border-box;
  }
  .org-dialog__crest img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .org-dialog__initial {
    color: var(--color-text-faint);
    font-size: var(--text-xl);
    font-weight: var(--weight-subhead);
  }

  .org-dialog__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .org-dialog__scroll {
    flex: 1 1 auto;
    overflow-y: auto;
    margin-top: var(--space-4);
  }

  /* With no headings the blocks are separated by space alone — so the rule is
     on the SIBLING rather than on each block, and a dialog missing one of them
     has no leading gap where it would have been. */
  .org-dialog__scroll > * + * { margin-top: var(--space-3); }

  .org-dialog__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .org-dialog__tag {
    padding: 2px 10px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .org-dialog__about {
    margin: 0;
    white-space: pre-wrap;
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .org-dialog__contact {
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
    font-size: var(--text-sm);
  }
  .org-dialog__contact-row { color: var(--color-text-muted); }
  .org-dialog__contact-row + .org-dialog__contact-row { margin-top: 2px; }
  .org-dialog__contact-row a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .org-dialog__contact-row a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .org-dialog__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
</style>

<script>
  // Card → dialog, and backdrop → close. The same wiring GroupDialog uses; it
  // runs once for every dialog on the page because Astro hoists and de-dupes an
  // identical inline module.
  const openers = document.querySelectorAll<HTMLElement>("[data-open-org]");
  for (const card of openers) {
    card.addEventListener("click", () => {
      const id = card.dataset.openOrg;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  }

  // Click outside to close. A dialog element covers the whole viewport
  // including its backdrop, so a click landing on IT rather than on its
  // contents is a click on the backdrop.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-org-dialog]")) {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
