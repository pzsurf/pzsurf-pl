---
// ONE event: what it is, when it is, and a way to it.
//
// A LINK, not a dialog. Every other card on this page opens something this page
// already holds; an event's details live somewhere else — its own site where it
// has one, the platform's page otherwise — so the honest control is an anchor
// that goes there. This page is a signpost to the federation's calendar, not the
// entry form.
//
// A PAST event is dimmed and still a link. Last year's edition is how somebody
// decides whether to enter this year's, so removing it would lose the only
// evidence that the federation runs these things at all.
import type { PublicOrgEvent } from "../lib/api";
import { eventDates, eventTypeLabel, isPastEvent } from "../lib/api";

interface Props { event: PublicOrgEvent }
const { event } = Astro.props;

const past = isPastEvent(event);
// The event's own site when it has one. Otherwise the platform's page for it,
// which is where its description, location and registration live.
const href = event.external_url || `https://surfpoland.com/events/${event.id}`;
---
<a
  class:list={["event", { "event--past": past }]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="event__media">
    {event.image_url
      ? <img src={event.image_url} alt="" loading="lazy" width="480" height="270" />
      : <span class="event__mono" aria-hidden="true">{eventTypeLabel(event.event_type)}</span>}
  </span>

  <span class="event__body">
    <span class="event__when">{eventDates(event)}</span>
    <span class="event__name">{event.name}</span>
    <span class="event__meta">
      <span class="event__type">{eventTypeLabel(event.event_type)}</span>
      {event.location_name && <span class="event__where">{event.location_name}</span>}
    </span>
  </span>
</a>

<style>
  .event {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .event:hover { border-color: var(--color-accent); }
  .event:hover .event__name { color: var(--color-accent); }
  .event:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .event__media {
    position: relative;
    display: grid;
    place-items: center;
    /* A definite box, never `aspect-ratio` alone: a content-sized grid track
       lets the picture resolve its own height and escape the crop — the trap
       the roster cards document. */
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .event__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .event__mono {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }
  /* The date leads: for an event, WHEN is the thing a reader is scanning for. */
  .event__when {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.04em;
  }
  .event__name {
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
    line-height: 1.25;
    transition: color 0.15s ease;
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Spent, not hidden. Enough contrast left to read and to click. */
  .event--past { opacity: 0.62; }
  .event--past .event__media img { filter: grayscale(1); }
  .event--past:hover { opacity: 1; }
  .event--past:hover .event__media img { filter: none; }
</style>
