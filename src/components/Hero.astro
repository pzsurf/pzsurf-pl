---
import type { RenderedIntro } from "../lib/intro";

interface Props {
  title: string;
  lede: string;
  /** The federation's introduction from the platform. When present it takes the
   *  place of the title and the lede. */
  intro?: RenderedIntro | null;
}
const { title, lede, intro = null } = Astro.props;
---
<section class:list={["hero on-dark", { "hero--intro": intro }]}>
  {/* autoplay needs muted AND playsInline or iOS refuses and shows the poster
      — which is why the poster is worth having rather than a black rectangle.
      The video is decorative, so it is aria-hidden and the page reads fine
      without it: no control, no captions, nothing to miss. */}
  <video
    class="hero__video"
    autoplay muted loop playsinline
    preload="metadata"
    poster="/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    {/* The page keeps exactly one h1. An introduction with its own `# ` title
        supplies it; one without keeps the federation's name in the outline for
        screen readers and search engines, without printing it over the text
        that replaced it. The introduction's HTML is safe for set:html — see
        lib/intro.ts. */}
    {intro?.titleHtml
      ? <h1 class="hero__title" set:html={intro.titleHtml} />
      : <h1 class={intro ? "visually-hidden" : "hero__title"}>{title}</h1>}
    {intro
      ? <div class="hero__intro" set:html={intro.html} />
      : <p class="hero__lede">{lede}</p>}
  </div>

  {/* Out of the wording and down at the foot of the hero, directly above the
      scroll indicator: the button is not part of what the hero SAYS. It stays
      IN FLOW — its own bottom padding clears the indicator — because an
      absolute offset would sooner or later land it on top of a long
      introduction.

      A BUTTON, not a link: it opens a dialog on this page rather than going
      anywhere, and a link that navigates nowhere is a lie to a screen reader
      and to anyone who middle-clicks it. StatuteDialog binds every
      `[data-open-statute]` on the page, so the hero does not need to know the
      dialog exists. */}
  <div class="hero__cta">
    <button class="btn" type="button" data-open-statute>Statut Związku</button>
  </div>

  {/* A LINK, not an ornament. It points at the same place the button does, so
      a keyboard or screen-reader user gets the way down that the animation is
      advertising to everyone else. */}
  <a class="hero__scroll" href="#kadra" aria-label="Przewiń w dół, aby zobaczyć więcej">
    <span class="hero__scroll-mouse" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    /* A COLUMN: the wording takes the space above and centres itself within it
       (see .hero__inner), while the Statut button sits in its own row at the
       foot. Centred horizontally too, so the title and the introduction read as
       one stack over the middle of the footage. */
    flex-direction: column;
    align-items: center;
    /* Full height, matching surfpoland.com. `svh` is the small-viewport height
       — the area visible while a mobile browser's address bar is showing — so
       the hero and its indicator never hide behind the toolbar. The plain vh
       line is the fallback where svh is unsupported and must stay above it. */
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
  }

  /* A full-height hero hides the fact that there is anything below it, which is
     the exact reason this indicator has to exist rather than being decoration.
     Same idea as surfpoland.com's: a mouse outline with a wheel falling inside
     it, which reads as "scroll" without a word of copy to translate. */
  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    /* A generous target around a small glyph. */
    padding: var(--space-2);
  }
  .hero__scroll-mouse {
    display: block;
    width: 24px;
    height: 38px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 14px;
    position: relative;
  }
  .hero__scroll:hover .hero__scroll-mouse { border-color: #fff; }
  .hero__scroll-mouse::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 7px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    transform: translateX(-50%);
    animation: hero-scroll 1.6s ease-in-out infinite;
  }
  @keyframes hero-scroll {
    0%   { opacity: 0; transform: translate(-50%, 0); }
    40%  { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, 12px); }
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Carries the text contrast, so the wording stays legible over whatever
     frame of the footage happens to be showing. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.36) 42%,
      rgba(0, 0, 0, 0.78) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    /* Takes whatever height is left once the foot row has its own, and centres
       the wording inside that — so the text still reads as vertically centred
       while the button has left the stack. */
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
    padding-block: var(--space-6);
    text-align: center;
  }

  /* The foot of the hero. The bottom padding is the scroll indicator's own
     space — its 28px offset plus its 38px glyph — and a gap on top of that, so
     the button sits ABOVE the animation rather than over it. The top margin is
     a floor for the case where the wording above runs long: the two must never
     meet. */
  .hero__cta {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-5);
    padding-inline: var(--space-3);
    padding-bottom: calc(28px + 38px + var(--space-4));
  }
  /* The measures stay: centred text still needs a line length somebody can
     read, so each block keeps its cap and is centred in the gutter rather than
     stretched to the width of the page. */
  .hero__title {
    max-width: 18ch;
    margin-inline: auto;
    font-size: var(--text-hero);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
  }
  .hero__lede {
    max-width: 46ch;
    margin: var(--space-3) auto var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  /* An introduction can run longer than a lede, so the hero grows with it rather
     than clipping it at the fold — still at least a full screen. The extra
     padding keeps the last line clear of the scroll indicator. */
  .hero--intro {
    height: auto;
    min-height: 100vh;
    min-height: 100svh;
  }
  .hero--intro .hero__inner {
    padding-block: calc(var(--space-6) + var(--space-5));
  }
  .hero__intro {
    max-width: var(--measure);
    margin: var(--space-3) auto var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  /* `:global`, because this content is injected with set:html and carries none
     of the scoped attributes Astro adds to markup it writes itself. */
  .hero__intro > :global(:first-child) { margin-top: 0; }
  .hero__intro > :global(:last-child) { margin-bottom: 0; }
  .hero__intro :global(p),
  .hero__intro :global(ul),
  .hero__intro :global(ol),
  .hero__intro :global(table) { margin: 0 0 var(--space-3); }
  /* A centred bullet list is unreadable — the markers scatter down the middle —
     so a list keeps its left alignment inside a block that is itself centred.
     Same for a table, whose columns mean nothing centred. */
  .hero__intro :global(ul),
  .hero__intro :global(ol) {
    width: fit-content;
    margin-inline: auto;
    padding-left: 1.2em;
    text-align: left;
  }
  .hero__intro :global(table) {
    margin-inline: auto;
    text-align: left;
  }
  .hero__intro :global(h2),
  .hero__intro :global(h3),
  .hero__intro :global(h4),
  .hero__intro :global(h5),
  .hero__intro :global(h6) {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--color-text);
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    font-weight: var(--weight-subhead);
  }
  .hero__intro :global(strong),
  .hero__intro :global(a) { color: var(--color-text); }
  .hero__intro :global(a:hover) { color: var(--color-accent); }
  .hero__intro :global(img) {
    display: block;
    max-width: 100%;
    max-height: 40vh;
    height: auto;
    margin: var(--space-3) auto;
    border-radius: var(--radius);
  }
  .hero__intro :global(th),
  .hero__intro :global(td) {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Styles a <button> as well as an <a>, hence the resets: a button carries the
     UA's own font, background and border and inherits none of the page's.
     FILLED in the federation's red rather than outlined, and larger than the
     page's other controls: over moving footage an outline reads as decoration,
     and this is the one thing the hero actually asks anybody to do. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 var(--space-5);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-on-accent);
    cursor: pointer;
    /* Lifts it off footage, which is busy in a way flat colour is not. */
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .btn:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }
  /* A default focus ring would sit red-on-red over dark footage, so it is white
     with an offset — the keyboard path to the statute has to be visible. */
  .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* The footage is motion nobody asked for. Honour the preference by showing
     the poster instead — the scrim and the wording are unaffected. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .hero { background: #000 url("/hero-poster.jpg") center / cover no-repeat; }
    /* The dot stops, the mouse stays. The animation is decoration; the
       indicator itself is information about the page and must not vanish. */
    .hero__scroll-mouse::after { animation: none; opacity: 1; }
  }
</style>
