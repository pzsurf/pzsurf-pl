---
interface Props { title: string; lede: string }
const { title, lede } = Astro.props;
---
<section class="hero on-dark">
  {/* autoplay needs muted AND playsInline or iOS refuses and shows the poster
      — which is why the poster is worth having rather than a black rectangle.
      The video is decorative, so it is aria-hidden and the page reads fine
      without it: no control, no captions, nothing to miss. */}
  <video
    class="hero__video"
    autoplay muted loop playsinline
    preload="metadata"
    poster="/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <h1 class="hero__title">{title}</h1>
    <p class="hero__lede">{lede}</p>
    {/* A BUTTON, not a link: it opens a dialog on this page rather than going
        anywhere, and a link that navigates nowhere is a lie to a screen reader
        and to anyone who middle-clicks it. StatuteDialog binds every
        `[data-open-statute]` on the page, so the hero does not need to know
        the dialog exists.

        The scroll indicator below still points at #kadra, so the way down that
        "Zobacz kadrę" used to offer has not been taken away — it was always
        the more discoverable of the two. */}
    <button class="btn btn--outline" type="button" data-open-statute>Statut</button>
  </div>

  {/* A LINK, not an ornament. It points at the same place the button does, so
      a keyboard or screen-reader user gets the way down that the animation is
      advertising to everyone else. */}
  <a class="hero__scroll" href="#kadra" aria-label="Przewiń w dół, aby zobaczyć więcej">
    <span class="hero__scroll-mouse" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    /* Centred rather than bottom-aligned now the hero is full height: at 100vh
       bottom-aligned text sits on the very edge, and it would collide with the
       scroll indicator. Horizontally it stays left, as pzsurf.pl has it. */
    align-items: center;
    /* Full height, matching surfpoland.com. `svh` is the small-viewport height
       — the area visible while a mobile browser's address bar is showing — so
       the hero and its indicator never hide behind the toolbar. The plain vh
       line is the fallback where svh is unsupported and must stay above it. */
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
  }

  /* A full-height hero hides the fact that there is anything below it, which is
     the exact reason this indicator has to exist rather than being decoration.
     Same idea as surfpoland.com's: a mouse outline with a wheel falling inside
     it, which reads as "scroll" without a word of copy to translate. */
  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    /* A generous target around a small glyph. */
    padding: var(--space-2);
  }
  .hero__scroll-mouse {
    display: block;
    width: 24px;
    height: 38px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 14px;
    position: relative;
  }
  .hero__scroll:hover .hero__scroll-mouse { border-color: #fff; }
  .hero__scroll-mouse::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 7px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    transform: translateX(-50%);
    animation: hero-scroll 1.6s ease-in-out infinite;
  }
  @keyframes hero-scroll {
    0%   { opacity: 0; transform: translate(-50%, 0); }
    40%  { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, 12px); }
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Carries the text contrast, so the wording stays legible over whatever
     frame of the footage happens to be showing. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.36) 42%,
      rgba(0, 0, 0, 0.78) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--space-3);
    padding-block: var(--space-6);
  }
  .hero__title {
    max-width: 18ch;
    font-size: var(--text-hero);
    line-height: var(--leading-2xl);
    font-weight: var(--weight-display);
  }
  .hero__lede {
    max-width: 46ch;
    margin: var(--space-3) 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  /* Styles a <button> as well as an <a> now, hence the four resets: a button
     carries the UA's own font, background and border and inherits none of the
     page's. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-button);
    text-decoration: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }
  .btn--outline:hover { color: var(--color-accent); }

  /* The footage is motion nobody asked for. Honour the preference by showing
     the poster instead — the scrim and the wording are unaffected. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .hero { background: #000 url("/hero-poster.jpg") center / cover no-repeat; }
    /* The dot stops, the mouse stays. The animation is decoration; the
       indicator itself is information about the page and must not vanish. */
    .hero__scroll-mouse::after { animation: none; opacity: 1; }
  }
</style>
