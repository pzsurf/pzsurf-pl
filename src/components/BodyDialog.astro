---
// What a governance body IS — its own dialog rather than a mode on
// PersonDialog, because the content is a different thing rather than the same
// thing rendered differently: prose about a committee's remit, not a list of
// somebody's memberships.
//
// One dialog for the page, filled from the row that opened it, the same way
// PersonDialog works. The crest is the BODY's own, with the federation's mark
// as a fallback for a body that has none — the row that opens this dialog has
// already resolved which, and passes it in `data-body-crest`.
//
// It used to say bodies had no image of their own. That was wrong: `Image` is
// polymorphic over `governance_body` too, every body already had a crest, and
// the public API simply never returned it (surfpoland#31).
---
<dialog class="person body-dialog" data-body-dialog aria-labelledby="body-name">
  <form method="dialog" class="person__close-form">
    <button class="person__close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <div class="person__avatar body-dialog__crest" data-crest></div>
    <h2 class="person__name" id="body-name" data-body-name></h2>
    <p class="body-dialog__meta">
      <span data-body-type></span>
      <span aria-hidden="true">·</span>
      <span data-body-count></span>
    </p>
  </div>

  {/* `pre-wrap`, because these read as paragraphs and the API sends plain text
      with newlines rather than markup. Rendering it as a single block would
      run four paragraphs into one wall. */}
  <p class="body-dialog__desc" data-body-desc></p>
</dialog>

<style>
  /* The shell, head, circle and close button all come from tokens.css, which
     both dialogs share. Only what is different about a BODY lives here. */

  /* WIDER and TALLER than the person dialog, because the content is a different
     shape: a person's dialog holds a portrait and a handful of one-line rows,
     a body's holds several paragraphs of prose about its remit. Overriding
     here rather than widening `.person` in tokens.css keeps the person dialog
     at the 420px its content was measured for. */
  .body-dialog {
    width: min(720px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       RETRACTED, so a `100vh`-tall dialog is taller than what you can actually
       see until you scroll. The 2×var(--space-4) is the vertical breathing
       room either side. */
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, NEVER the bare class: the UA stylesheet hides a closed dialog
     with `display: none`, so an unqualified `display: flex` here would override
     it and leave the dialog permanently on the page. */
  .body-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  /* The head is fixed; only the prose scrolls, so the crest and the name stay
     put while a long remit is read. */
  .body-dialog .person__head { flex: none; }

  .body-dialog__crest { background: var(--color-bg); }
  /* `:global` because the script creates this <img> — a runtime node carries no
     data-astro-cid, so a scoped selector never matches it. */
  .body-dialog__crest :global(img) {
    /* `contain`, not the person avatar's `cover`: a crest cropped to fill a
       circle loses its edges, which is the part that makes it recognisable. */
    object-fit: contain;
    padding: 10px;
  }

  .body-dialog__meta {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }
  .body-dialog__desc {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    white-space: pre-wrap;
    text-align: left;
    /* `0 1 auto` rather than `1 1 auto`, so the dialog GROWS WITH the content
       instead of always filling the screen: a short remit gets a short dialog,
       and only prose that overflows the max-height above shrinks this box and
       starts scrolling. `min-height: 0` is what lets a flex item shrink below
       its content — without it the box refuses to shrink and the dialog
       overflows the viewport instead. */
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* Stops the scroll CHAINING: without it, reaching the end of a long remit
       hands the remaining wheel travel to the page behind, which is the one
       route still open to it once the root is locked. */
    overscroll-behavior: contain;
  }
  .body-dialog__desc:empty { display: none; }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-body-dialog]");
  if (dialog) {
    const set = (sel: string, text: string) => {
      const el = dialog.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };

    for (const row of document.querySelectorAll<HTMLElement>("[data-body]")) {
      row.addEventListener("click", () => {
        const d = row.dataset;
        set("[data-body-name]", d.bodyName ?? "");
        set("[data-body-type]", d.bodyType ?? "");
        set("[data-body-count]", d.bodyCount ?? "");
        set("[data-body-desc]", d.bodyDesc ?? "");

        const crest = dialog.querySelector<HTMLElement>("[data-crest]");
        if (crest) {
          crest.innerHTML = "";
          if (d.bodyCrest) {
            const img = document.createElement("img");
            img.src = d.bodyCrest;
            img.alt = "";
            crest.appendChild(img);
          }
        }
        dialog.showModal();
      });
    }

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
