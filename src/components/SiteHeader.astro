---
// The masthead: mark on the left, sections on the right — the shape the
// federation's existing site uses. It sits OVER the hero (position: absolute)
// rather than above it, so the video runs to the top of the window.
//
// Only real destinations appear here. The source site's menu has six sections
// this one has not built yet; inventing links that 404 would look complete and
// behave worse than an honest short menu.
const links = [
  { label: "Kadra", href: "#kadra" },
  { label: "Władze", href: "#wladze" },
  { label: "Kontakt", href: "#kontakt" },
];
---
<header class="masthead on-dark">
  {/* The federation's own horizontal logotype — shield, PZS and the full name
      are all INSIDE the image, so there is no HTML wordmark beside it to keep
      in step, and no risk of the two disagreeing at a breakpoint.

      Taken from pzsurf.pl, where the header uses this same red-on-dark asset
      at the same sort of size. Red over dark footage is the federation's own
      usage, not an oversight to correct: there is no white variant published,
      and inventing one by filtering would change their mark.

      `alt` carries the name because the image IS the name here; a decorative
      empty alt would leave the site's own title unreadable to a screen reader. */}
  <a class="masthead__brand" href="/">
    <img src="/pzs-logotype.png" alt="Polski Związek Surfingu"
         width="330" height="178" />
  </a>
  <nav class="masthead__nav" aria-label="Główne">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .masthead {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-3);
    /* The band supplies its own light-on-dark roles; it has no background of
       its own because the hero behind it is already dark. */
    background: transparent;
  }
  .masthead__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  /* Height-driven: the intrinsic width/height on the <img> gives the browser the
     aspect ratio up front, so the row does not jump as the logo loads.
     The asset is CROPPED to its ink — the original carried 45px of transparent
     padding on top and 31px below on a 250px canvas, so 70% of any height you
     set was the logo and 30% was nothing. That is why it first rendered as a
     smudge at a size that should have been ample. */
  .masthead__brand img {
    width: auto;
    height: 46px;
    /* Lifts the mark off dark footage without recolouring it. */
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45));
  }
  .masthead__nav {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .masthead__nav a {
    color: var(--color-text);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }
  .masthead__nav a:hover { border-bottom-color: var(--color-accent); }

  @media (max-width: 560px) {
    .masthead { padding: var(--space-2) var(--space-3); }
    .masthead__nav { gap: var(--space-3); letter-spacing: 0.08em; }
    /* Smaller, but not so small that the two lines under PZS turn to mush. */
    .masthead__brand img { height: 34px; }
  }
</style>
