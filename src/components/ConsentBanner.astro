---
// The cookie question, asked once, at the very top of every page until it is
// answered. ONE LINE, not a paragraph (the federation's choice, September
// 2026: the full-size banner pushed the hero down and read as intrusive). The
// explanation lives one click away on /pliki-cookies/; the bar keeps only what
// a decision needs — what is asked, two equal answers, and where to read more. Modelled on the GOV.UK Design System's cookie banner, the most
// tested accessible pattern there is:
//
// - IN THE FLOW, first thing in <body>, not a fixed overlay. Nothing is ever
//   covered by it (WCAG 2.4.11 Focus Not Obscured), it does not fight the
//   accessibility button for a corner, and a screen reader meets it first.
// - Not modal and does not grab focus: the page stays fully usable unanswered,
//   and NOTHING is tracked until "Akceptuję" (lib/analytics.ts).
// - Accept and reject are the same kind of button, side by side, on the first
//   screen: refusing is exactly as easy as agreeing, as the EDPB's cookie
//   banner taskforce requires. No pre-ticked boxes, no "by continuing to
//   browse you agree".
// - After a choice, the question is replaced by a one-line confirmation that
//   takes focus (the button just pressed has gone), saying where to change it.
//
// Hidden in the markup and revealed by the script, so without JavaScript there
// is no question — and no analytics either, since that needs the script too.
// Not shown on /pliki-cookies/ itself, which carries the full settings.
---
<div class="consent" data-consent hidden>
  {/* A region with a name rather than a visible heading: the heading was most
      of the banner's height, and a screen reader still announces the landmark
      by name ("Pliki cookies") before the sentence. */}
  <section class="consent__inner" data-consent-ask role="region" aria-label="Pliki cookies">
    <p class="consent__text">
      Za&nbsp;Twoją zgodą zbieramy statystyki korzystania ze&nbsp;strony przy pomocy
      plików cookies.
      <a class="consent__link" href="/pliki-cookies/">Więcej</a>
    </p>
    <div class="consent__actions">
      {/* Short on screen, whole to a screen reader: "Akceptuję" alone, heard
          out of context in a list of buttons, does not say what is accepted. */}
      <button type="button" class="consent__btn" data-consent-choice="yes">Akceptuję<span class="visually-hidden"> analityczne pliki cookies</span></button>
      <button type="button" class="consent__btn" data-consent-choice="no">Odrzucam<span class="visually-hidden"> analityczne pliki cookies</span></button>
    </div>
  </section>

  <div class="consent__inner" data-consent-done tabindex="-1" hidden
       role="region" aria-label="Pliki cookies">
    <p class="consent__text" data-consent-message></p>
    <div class="consent__actions">
      <button type="button" class="consent__btn consent__btn--quiet" data-consent-hide>Ukryj<span class="visually-hidden"> komunikat</span></button>
    </div>
  </div>
</div>

<style>
  .consent {
    background: var(--color-bg-raised);
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }
  .consent[hidden] { display: none; }
  /* One row where it fits, the buttons dropping under the sentence where it
     does not (a phone): still two short lines, not a block. */
  .consent__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-3);
  }
  .consent__inner[hidden] { display: none; }
  [data-consent-done]:focus { outline: none; }
  [data-consent-done]:focus-visible { outline: 3px solid var(--color-accent); outline-offset: -3px; }
  .consent__text {
    flex: 1 1 24ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }
  .consent__actions {
    display: flex;
    flex: none;
    gap: var(--space-2);
  }
  /* The site's button (Hero's `.btn`): the muted red fill, the display face,
     the same corner — so the question reads as part of this site rather than a
     plug-in bolted on top. Both choices share ONE style: neither is the
     "primary" answer. Compact (36px, the gap between them keeps WCAG 2.5.8's
     24px spacing) and without the hero's heavy shadow, which is there to lift
     a button off moving footage; on paper a hairline one is enough. */
  .consent__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-accent-muted);
    color: var(--color-on-accent-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
    transition: background-color 0.15s ease, transform 0.2s ease;
  }
  .consent__btn:hover {
    background: var(--color-accent-muted-strong);
    transform: translateY(-1px);
  }
  .consent__btn:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  /* "Ukryj" is not an answer, so it takes the hero's outline companion
     (`.btn--quiet`), drawn in ink on paper instead of cream on footage. */
  .consent__btn--quiet {
    background: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
  }
  .consent__btn--quiet:hover {
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .consent__btn:hover { transform: none; }
  }
  .consent__link { color: var(--color-accent); white-space: nowrap; }
  /* :global because the confirmation's link is written by the script, so it
     carries no scoped-style attribute. */
  .consent :global(a) { color: var(--color-accent); }
  @media print { .consent { display: none; } }
</style>

<script>
  import { GA_ID, applyConsent, readConsent, saveConsent } from "../lib/analytics";

  const root = document.querySelector<HTMLElement>("[data-consent]");
  const current = readConsent();
  // Every page applies a decision already made: that is what loads analytics
  // on the second page a consenting reader opens.
  if (current) applyConsent(current.analytics);

  const onSettingsPage = location.pathname.startsWith("/pliki-cookies");
  // DEV ONLY: `?consent` in the address shows the banner whatever the state —
  // with no GA id, after a decision was already stored. For working on the
  // banner itself. Without an id, answering it only stores the choice and
  // nothing is requested from Google. Compiled out of production builds.
  const preview = import.meta.env.DEV && new URLSearchParams(location.search).has("consent");
  if (root && (preview || (GA_ID && !current && !onSettingsPage))) {
    const ask = root.querySelector<HTMLElement>("[data-consent-ask]")!;
    const done = root.querySelector<HTMLElement>("[data-consent-done]")!;
    const message = root.querySelector<HTMLElement>("[data-consent-message]")!;
    root.hidden = false;

    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-consent-choice]")) {
      b.addEventListener("click", () => {
        const yes = b.dataset.consentChoice === "yes";
        saveConsent(yes);
        message.innerHTML = `${yes ? "Zaakceptowano" : "Odrzucono"} analityczne pliki cookies. `
          + `Zmienisz to na&nbsp;stronie <a href="/pliki-cookies/">Pliki cookies</a>.`;
        ask.hidden = true;
        done.hidden = false;
        done.focus();
      });
    }
    root.querySelector("[data-consent-hide]")?.addEventListener("click", () => {
      root.hidden = true;
      // Focus must go SOMEWHERE (the button holding it has just gone), but NOT
      // to the skip link: that link shows itself whenever it has focus, so it
      // popped up over the hero after every "Ukryj" and stayed there. The top
      // of the content instead — the hero on the front page, <main> on the
      // others — quietly, without scrolling or a ring (tokens.css).
      const next = document.querySelector<HTMLElement>("#tresc, main");
      if (next) {
        if (!next.hasAttribute("tabindex")) next.tabIndex = -1;
        next.focus({ preventScroll: true });
      }
    });
  }
</script>
