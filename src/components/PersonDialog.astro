---
// ONE dialog for the whole page, filled from the card that opened it.
//
// One rather than 36: the cards already carry every field the dialog shows, so
// a dialog per athlete would triple the markup for nothing. The shape follows
// surfpoland.com's own public profile — round photo, name, role, discipline,
// then the national-team block — because a visitor moving between the two
// should recognise the same record.
//
// What it CANNOT show is anything more than the card has. The public API
// exposes no per-person endpoint and no stable person id, by design
// (docs/api/public-v0.md §4.5), so there is nothing further to fetch. That is
// also why this is a dialog rather than a link to a profile page: there is no
// address to link to.
---
<dialog class="person" data-person-dialog aria-labelledby="person-name">
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close dialog-close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <div class="person__avatar" data-avatar></div>
    <h2 class="person__name dialog-title" id="person-name" data-name></h2>
  </div>

  <div class="person__section">
    <h3 class="person__section-title" data-group></h3>
    {/* One row per squad, filled by the script. */}
    <ul class="person__teams" data-teams-list></ul>
  </div>

  {/* Bottom of the dialog. Socials sit RIGHT; the left half is deliberately
      empty for now — organisation crests belong there and are out of scope
      until the public organisations view exists. The row is only rendered when
      there is something in it, so an empty footer never claims space. */}
  <div class="person__foot" data-foot hidden>
    <div class="person__foot-left"></div>
    <div class="person__socials" data-socials-slot></div>
  </div>
</dialog>

<style>
  .person__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .person__socials { display: flex; gap: var(--space-2); }

  .person__section { margin-top: var(--space-5); }
  .person__section-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .person__teams {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* ONE LINE per squad: the season and squad on the left, the age categories
     on the right, never stacked. `space-between` puts the gap in the middle so
     the categories align down the right edge whatever the squad name's length,
     and `nowrap` on both halves keeps the row a row.
     `:global()` because the SCRIPT builds these rows: Astro scopes by a
     data-astro-cid stamped onto template elements, and a node created at
     runtime has none, so scoped selectors miss it completely — the rows
     rendered as unstyled list items stacked two lines tall. Scoped on the
     ancestor, global on the descendant, so nothing leaks past this dialog. */
  .person__teams :global(.person__team) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    text-align: left;
  }
  .person__teams :global(.person__team-name) {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    white-space: nowrap;
  }
  .person__teams :global(.person__team-cats) {
    margin: 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    white-space: nowrap;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-person-dialog]");
  if (dialog) {
    const set = (sel: string, text: string) => {
      const el = dialog.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };

    for (const card of document.querySelectorAll<HTMLElement>("[data-person]")) {
      card.addEventListener("click", () => {
        const d = card.dataset;
        set("[data-name]", d.name ?? "");
        set("[data-group]", d.group ?? "");

        // EVERY membership of this kind, one row each — a dialog that named
        // only the card you happened to click would under-report anyone who
        // sits on more than one squad or committee, and many do.
        const list = dialog.querySelector<HTMLElement>("[data-teams-list]");
        if (list) {
          list.innerHTML = "";
          const rows: { label: string; detail: string }[] = JSON.parse(d.rows || "[]");
          for (const r of rows) {
            const li = document.createElement("li");
            li.className = "person__team";
            const label = document.createElement("p");
            label.className = "person__team-name";
            label.textContent = r.label;
            li.appendChild(label);
            // Only when there is one: an empty node would still claim its gap.
            if (r.detail) {
              const detail = document.createElement("p");
              detail.className = "person__team-cats";
              detail.textContent = r.detail;
              li.appendChild(detail);
            }
            list.appendChild(li);
          }
        }

        const avatar = dialog.querySelector<HTMLElement>("[data-avatar]");
        if (avatar) {
          // Same rule as the card: a photograph when there is one, the initials
          // when there is not. Built rather than cloned so the round frame gets
          // its own element sizing.
          avatar.innerHTML = "";
          if (d.image) {
            const img = document.createElement("img");
            img.src = d.image;
            img.alt = "";
            avatar.appendChild(img);
          } else {
            avatar.textContent = d.initials ?? "";
          }
        }
        // Clone the card's own socials template. Cloning rather than rebuilding
        // keeps one source for the markup and the icons.
        const foot = dialog.querySelector<HTMLElement>("[data-foot]");
        const slot = dialog.querySelector<HTMLElement>("[data-socials-slot]");
        const template = card.querySelector<HTMLTemplateElement>("[data-socials]");
        if (foot && slot) {
          slot.innerHTML = "";
          if (template) slot.appendChild(template.content.cloneNode(true));
          // `hidden` rather than an empty row: a footer with nothing in it
          // still costs its own margin.
          foot.hidden = !template;
        }

        dialog.showModal();
      });
    }

    // Click outside to close. The dialog element itself covers the whole
    // viewport including its backdrop, so a click landing on IT rather than on
    // its contents is a click on the backdrop.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
