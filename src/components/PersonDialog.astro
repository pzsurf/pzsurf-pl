---
// ONE dialog for the whole page, filled from the card that opened it.
//
// One rather than 36: the cards already carry every field the dialog shows, so
// a dialog per athlete would triple the markup for nothing. The shape follows
// surfpoland.com's own public profile — round photo, name, role, discipline,
// then the national-team block — because a visitor moving between the two
// should recognise the same record.
//
// What it CANNOT show is anything more than the card has. The public API
// exposes no per-person endpoint and no stable person id, by design
// (docs/api/public-v0.md §4.5), so there is nothing further to fetch. That is
// also why this is a dialog rather than a link to a profile page: there is no
// address to link to.
---
<dialog class="person" data-person-dialog aria-labelledby="person-name">
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <div class="person__avatar" data-avatar></div>
    <h2 class="person__name" id="person-name" data-name></h2>
    <p class="person__badges">
      <span class="badge badge--role" data-role></span>
      <span class="badge" data-team></span>
    </p>
  </div>

  <div class="person__section">
    <h3 class="person__section-title">Kadra narodowa</h3>
    <div class="person__team">
      <p class="person__team-name" data-team-line></p>
      <p class="person__team-cats" data-cats></p>
    </div>
  </div>
</dialog>

<style>
  .person {
    width: min(420px, calc(100vw - 32px));
    padding: var(--space-5) var(--space-4) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    background: var(--color-bg-raised);
    color: var(--color-text);
  }
  .person::backdrop { background: rgba(10, 16, 24, 0.55); }

  .person__close-form { margin: 0; }
  .person__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-faint);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .person__close:hover { color: var(--color-accent); }

  .person__head { text-align: center; }
  .person__avatar {
    width: 104px;
    height: 104px;
    margin: 0 auto var(--space-3);
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
    color: rgba(255, 255, 255, 0.7);
    font-size: 34px;
    font-weight: var(--weight-display);
  }
  .person__avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .person__name {
    margin: 0;
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    font-weight: var(--weight-display);
  }
  .person__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }
  .badge {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    color: var(--color-text-muted);
  }
  .badge--role { border-color: var(--color-accent); color: var(--color-accent); }
  .badge:empty { display: none; }

  .person__section { margin-top: var(--space-5); }
  .person__section-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-subhead);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .person__team {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .person__team-name { margin: 0; font-weight: var(--weight-subhead); }
  .person__team-cats { margin: var(--space-1) 0 0; color: var(--color-text-faint); font-size: var(--text-sm); }
  .person__team-cats:empty { display: none; }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-person-dialog]");
  if (dialog) {
    const set = (sel: string, text: string) => {
      const el = dialog.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };

    // The API's role is a code. Only ATHLETE occurs on today's rosters; anything
    // else is shown as it came rather than invented a translation for.
    const ROLE_PL: Record<string, string> = { ATHLETE: "Zawodnik" };

    for (const card of document.querySelectorAll<HTMLElement>("[data-person]")) {
      card.addEventListener("click", () => {
        const d = card.dataset;
        set("[data-name]", d.name ?? "");
        set("[data-role]", d.role ? (ROLE_PL[d.role] ?? d.role) : "");
        set("[data-team]", d.team ?? "");
        set("[data-team-line]", `${d.year} — ${d.team}`);
        set("[data-cats]", d.cats ?? "");

        const avatar = dialog.querySelector<HTMLElement>("[data-avatar]");
        if (avatar) {
          // Same rule as the card: a photograph when there is one, the initials
          // when there is not. Built rather than cloned so the round frame gets
          // its own element sizing.
          avatar.innerHTML = "";
          if (d.image) {
            const img = document.createElement("img");
            img.src = d.image;
            img.alt = "";
            avatar.appendChild(img);
          } else {
            avatar.textContent = d.initials ?? "";
          }
        }
        dialog.showModal();
      });
    }

    // Click outside to close. The dialog element itself covers the whole
    // viewport including its backdrop, so a click landing on IT rather than on
    // its contents is a click on the backdrop.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
