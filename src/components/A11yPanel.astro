---
// "Ułatwienia dostępu": the reader's own adjustments, on every page. Built into
// the site rather than bought as an overlay widget: no third-party script, no
// tracking, nothing that rewrites the page behind the reader's back, and it
// only ever ADDS to a page that already meets WCAG 2.2 AA on its own.
//
// A round button with the international accessibility figure, fixed to the
// bottom-left corner where readers of Polish official sites look for it,
// opening a panel of switches. Each switch is a real <button aria-pressed>, so
// a screen reader announces its state; the settings themselves are CSS in
// styles/a11y.css and the logic in lib/a11y.ts.
//
// Deliberately NOT offered: "read the page aloud" (every phone and computer
// ships a screen reader that does it better than a widget can) and a language
// menu (the site is in Polish only).

interface Tile {
  key: "text" | "contrast" | "links" | "spacing" | "motion" | "images" | "font";
  label: string;
  /** The attribute value that means "on". Text size cycles instead. */
  on: string;
  icon: string;
}
const svg = (body: string) =>
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
const TILES: Tile[] = [
  { key: "text", label: "Większy tekst", on: "1",
    icon: svg('<path d="M3 7V5h8v2M7 5v14M5 19h4"/><path d="M13 11v-1h8v1M17 10v9M15 19h4"/>') },
  { key: "contrast", label: "Wysoki kontrast", on: "on",
    icon: svg('<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>') },
  { key: "links", label: "Podświetl linki", on: "on",
    icon: svg('<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>') },
  { key: "spacing", label: "Odstępy w tekście", on: "on",
    icon: svg('<path d="M3 12h18M6 9l-3 3 3 3M18 9l3 3-3 3"/><path d="M3 5h18M3 19h18" stroke-dasharray="2 3"/>') },
  { key: "motion", label: "Zatrzymaj animacje", on: "off",
    icon: svg('<circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/>') },
  { key: "images", label: "Ukryj obrazy", on: "off",
    icon: svg('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m3 16 5-5 5 5M14 14l2-2 5 5"/><path d="M4 3l17 18"/>') },
  { key: "font", label: "Czytelna czcionka", on: "on",
    icon: svg('<path d="M4 19 9 5l5 14M6 14h6"/><path d="M15 15a3 3 0 1 0 6 0v4M21 15a3 3 0 0 0-6 0"/>') },
];
---
<button type="button" class="a11y-fab" data-a11y-open aria-haspopup="dialog"
        aria-label="Ułatwienia dostępu" title="Ułatwienia dostępu">
  {/* The international symbol of accessibility (the "accessible icon" figure). */}
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <circle cx="12" cy="4" r="2" />
    <path d="M19 8.5c-2.2.6-4.4.9-7 .9s-4.8-.3-7-.9l-.5 1.9c1.8.5 3.7.8 5.5.9V14l-2 7h2.1l1.9-6 1.9 6h2.1l-2-7v-2.7c1.8-.1 3.7-.4 5.5-.9z" />
  </svg>
</button>

<dialog class="a11y" id="a11y-panel" data-a11y-dialog aria-labelledby="a11y-title">
  <div class="a11y__head">
    <h2 class="a11y__title" id="a11y-title">Ułatwienia dostępu</h2>
    <form method="dialog" class="a11y__close-form">
      <button class="a11y__close" aria-label="Zamknij">×</button>
    </form>
  </div>

  <div class="a11y__grid">
    {TILES.map((t) => (
      <button type="button" class="a11y__tile" data-a11y-key={t.key} data-a11y-on={t.on}
              aria-pressed="false">
        <span class="a11y__icon" set:html={t.icon} />
        <span class="a11y__label">{t.label}</span>
        {/* Only text size has more than on/off; its level shows here. */}
        {t.key === "text" && <span class="a11y__level" data-a11y-level>100%</span>}
      </button>
    ))}
  </div>

  <div class="a11y__foot">
    <button type="button" class="a11y__reset" data-a11y-reset>Przywróć domyślne</button>
    <span class="a11y__links">
      <a class="a11y__link" href="/deklaracja-dostepnosci/">Deklaracja dostępności</a>
      <a class="a11y__link" href="/tekst-latwy-do-czytania/">Tekst łatwy do czytania</a>
    </span>
  </div>
</dialog>

<style>
  /* Fixed bottom-left. 48px, well over the 24px WCAG 2.5.8 asks for, and
     small enough never to cover a whole control (2.4.11 Focus Not Obscured). */
  .a11y-fab {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 2px solid var(--palette-paper);
    border-radius: 50%;
    background: var(--palette-slate);   /* the theme's own slate: 8.2:1 with the white figure */
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .a11y-fab:hover { background: #2a3b4e; }
  .a11y-fab:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  @media print { .a11y-fab { display: none; } }

  /* The panel opens from the button's corner rather than the middle of the
     screen, so it reads as belonging to it. */
  .a11y {
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100svh - 96px);
    margin: auto auto 80px 16px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-raised);
    color: var(--color-text);
    box-shadow: 0 2px 4px rgba(71, 56, 33, 0.08), 0 24px 60px rgba(40, 30, 15, 0.22);
  }
  .a11y[open] { display: flex; flex-direction: column; }
  .a11y::backdrop { background: rgba(40, 32, 22, 0.25); }

  .a11y__head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .a11y__title { font-size: var(--text-lg); font-weight: var(--weight-display); }
  .a11y__close-form { margin: 0; }
  .a11y__close {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .a11y__close:hover { color: var(--color-accent); }

  .a11y__grid {
    flex: 1 1 auto;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
  }
  .a11y__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 104px;
    padding: var(--space-3) var(--space-2);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
  }
  .a11y__tile:hover { border-color: var(--color-text-muted); }
  .a11y__tile:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  /* ON: filled and ticked, so the state is not carried by colour alone
     (WCAG 1.4.1). */
  .a11y__tile[aria-pressed="true"] {
    border-color: var(--palette-slate);
    background: #e6ebf0;
    color: #1f2d3c;
    position: relative;
  }
  .a11y__tile[aria-pressed="true"]::after {
    content: "✓";
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 14px;
    font-weight: var(--weight-display);
  }
  .a11y__icon { display: grid; }
  .a11y__level { font-size: var(--text-xs); font-weight: var(--weight-body); color: var(--color-text-muted); }
  .a11y__tile[aria-pressed="true"] .a11y__level { color: #1f2d3c; }

  .a11y__foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .a11y__reset {
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .a11y__reset:hover { border-color: var(--color-text-muted); }
  .a11y__links { display: flex; flex-direction: column; gap: var(--space-1); text-align: right; }
  .a11y__link { color: var(--color-accent); font-size: var(--text-sm); }
</style>

<script>
  import { A11Y_KEYS, writeSetting, readSettings, type A11yKey } from "../lib/a11y";

  const dialog = document.querySelector<HTMLDialogElement>("[data-a11y-dialog]");
  const opener = document.querySelector<HTMLButtonElement>("[data-a11y-open]");
  if (dialog && opener) {
    const tiles = [...dialog.querySelectorAll<HTMLButtonElement>("[data-a11y-key]")];
    const level = dialog.querySelector<HTMLElement>("[data-a11y-level]");
    const TEXT_LEVELS = ["", "1", "2"];
    const TEXT_LABELS = ["100%", "115%", "130%"];

    // Draw every tile from what is actually applied, so the panel never
    // disagrees with the page (the stored choice was applied before paint).
    const sync = () => {
      const s = readSettings();
      for (const t of tiles) {
        const key = t.dataset.a11yKey as A11yKey;
        const pressed = key === "text" ? Boolean(s.text) : s[key] === t.dataset.a11yOn;
        t.setAttribute("aria-pressed", String(pressed));
      }
      if (level) level.textContent = TEXT_LABELS[Math.max(0, TEXT_LEVELS.indexOf(s.text ?? ""))];
    };

    for (const t of tiles) {
      t.addEventListener("click", () => {
        const key = t.dataset.a11yKey as A11yKey;
        if (key === "text") {
          const i = TEXT_LEVELS.indexOf(readSettings().text ?? "");
          const next = TEXT_LEVELS[(i + 1) % TEXT_LEVELS.length];
          writeSetting("text", next || null);
        } else {
          const on = t.getAttribute("aria-pressed") === "true";
          writeSetting(key, on ? null : t.dataset.a11yOn!);
        }
        sync();
      });
    }
    dialog.querySelector("[data-a11y-reset]")?.addEventListener("click", () => {
      for (const k of A11Y_KEYS) writeSetting(k, null);
      sync();
    });

    opener.addEventListener("click", () => {
      sync();
      dialog.showModal();
    });
    // Backdrop click closes, as every dialog here does.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Opened by something other than the opener too — the layout reopens it
    // on "back" from the accessibility statement (Base.astro) — so the
    // buttons are brought up to date on every opening, not only on a click.
    new MutationObserver(() => { if (dialog.open) sync(); })
      .observe(dialog, { attributes: true, attributeFilter: ["open"] });
  }
</script>
