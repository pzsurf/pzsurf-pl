---
// AN AFFILIATED ORGANISATION, as a tile: crest and name, opening its own dialog.
//
// The same treatment surfpoland.com gives its affiliate grid, deliberately — a
// visitor moving between the two sites should recognise the same record. The
// crest sits on a fixed LIGHT tile there for a reason worth repeating here: a
// club's logo is routinely black on transparent, and black needs a light
// backdrop rather than a merely less-dark one. Here the whole section is on a
// light band, so the tile is doing less work, but it still gives every crest
// the same ground whatever it was drawn against — and a logo with its own white
// background no longer reads as a brighter square than its neighbours.
//
// A BUTTON, not an article with a click handler: focusable, driven by Enter and
// Space, announced as something that can be activated. `aria-haspopup` says what
// activating it does and `data-open-org` names the dialog, which is rendered
// separately with its details inside it — the same contract GroupCard has with
// GroupDialog.
//
// NOT a link to surfpoland.com. The dialog carries everything the API will tell
// us about this organisation, so opening it is the whole answer; the dialog then
// offers the link out for anyone who wants the fuller record.

interface Props {
  /** The id of the dialog this card opens. */
  dialogId: string;
  name: string;
  crest: string | null;
}
const { dialogId, name, crest } = Astro.props;

// The initial rather than a generic placeholder: a wall of identical grey
// squares tells a reader nothing about which club is which.
const initial = (name.trim()[0] ?? "?").toUpperCase();
---
<button
  type="button"
  class="org"
  data-open-org={dialogId}
  aria-haspopup="dialog"
>
  <span class="org__crest" aria-hidden="true">
    {crest
      ? <img src={crest} alt="" loading="lazy" width="112" height="112" />
      : <span class="org__initial">{initial}</span>}
  </span>
  <span class="org__name">{name}</span>
</button>

<style>
  .org {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
    padding: var(--space-3) var(--space-2);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    font: inherit;
    color: inherit;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .org:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .org:hover .org__name { color: var(--color-accent); }
  .org:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  /* The fixed light ground every crest is drawn on — see the note above. */
  .org__crest {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    padding: 6px;
    box-sizing: border-box;
    background: #f4f6f8;
    border-radius: 10px;
  }
  .org__crest img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Fixed dark ink, because the tile under it is fixed light. */
  .org__initial {
    color: #5a6472;
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }

  .org__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
</style>
