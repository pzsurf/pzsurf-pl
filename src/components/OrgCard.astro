---
// AN AFFILIATED ORGANISATION, as a tile: crest and name, opening its own dialog.
//
// The same shape surfpoland.com gives its affiliate grid — a visitor moving
// between the two sites should recognise the same record — but NOT the tinted
// tile behind the crest. That tile earns its place over there because the card
// is dark and a club's logo is routinely black on transparent; here the band is
// light and the card is white already, so black reads without help. Tinting it
// only drew a grey box around the many logos that ship with their own white
// background. So the crest sits straight on the card, the way an event card's
// media sits straight in its own frame.
//
// A BUTTON, not an article with a click handler: focusable, driven by Enter and
// Space, announced as something that can be activated. `aria-haspopup` says what
// activating it does and `data-open-org` names the dialog, which is rendered
// separately with its details inside it — the same contract GroupCard has with
// GroupDialog.
//
// NOT a link to surfpoland.com. The dialog carries everything the API will tell
// us about this organisation, so opening it is the whole answer; the dialog then
// offers the link out for anyone who wants the fuller record.

interface Props {
  /** The id of the dialog this card opens. */
  dialogId: string;
  name: string;
  crest: string | null;
}
const { dialogId, name, crest } = Astro.props;

// The initial rather than a generic placeholder: a wall of identical grey
// squares tells a reader nothing about which club is which.
const initial = (name.trim()[0] ?? "?").toUpperCase();
---
<button
  type="button"
  class="org"
  data-open-org={dialogId}
  aria-haspopup="dialog"
>
  <span class="org__crest" aria-hidden="true">
    {crest
      ? <img src={crest} alt="" loading="lazy" width="112" height="112" />
      : <span class="org__initial">{initial}</span>}
  </span>
  <span class="org__name">{name}</span>
</button>

<style>
  .org {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
    padding: var(--space-3) var(--space-2);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    font: inherit;
    color: inherit;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .org:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .org:hover .org__name { color: var(--color-accent); }
  .org:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  /* No ground of its own: the card's white is the ground — see the note above.
     The padding stays, so a logo drawn to its own edges is not touching the
     name below it. */
  .org__crest {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
    padding: 6px;
    box-sizing: border-box;
  }
  .org__crest img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* The card is light on this site, so the themed muted ink reads on it — no
     need for the fixed dark one surfpoland.com's dark card forces. */
  .org__initial {
    color: var(--color-text-faint);
    font-size: var(--text-lg);
    font-weight: var(--weight-subhead);
  }

  .org__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }
</style>
