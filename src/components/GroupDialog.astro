---
// One group's roster, in its own dialog: a national-team division, the board,
// or a komisja. Opened by the matching GroupCard.
//
// A dialog PER group, rendered at build time with its people inside it —
// deliberately not one shared dialog filled by a script. Two reasons, both
// about what this site is for:
//
//   * every name and photograph stays in the document as written, so link
//     previews and crawlers read the whole roster. A script-filled dialog would
//     leave the roster in data attributes, and a <template> would make it inert.
//   * there is nothing to build at runtime. A dozen dialogs of real markup cost
//     a few kilobytes and no JavaScript beyond `showModal()`.
//
// The people are READ here, never opened. The public API exposes no per-person
// endpoint and no stable person id by design (docs/api/public-v0.md §4.5), so
// there is nothing to open one against; an athlete's full card lives on
// surfpoland.com.
//
// NO CREST, even for a body that has one: the head is the name, as the national
// team's dialog is. The crest identifies the body in the grid of cards, which is
// where it is doing work.

interface Props {
  /** Matches the `dialogId` of the card that opens it. */
  id: string;
  title: string;
  count: number;
  /** Ahead of the headcount in the meta line: a season, or a body's kind. */
  meta?: string[];
  /** A body's remit, as the API sends it: plain text with newlines. */
  description?: string | null;
  people: { name: string; image: string | null; subtitle: string }[];
}
const { id, title, count, meta = [], description = null, people } = Astro.props;

// Polish counts three ways, and "1 osoba" / "2 osoby" / "8 osób" are not
// interchangeable.
function headcount(n: number): string {
  if (n === 1) return "1 osoba";
  const ten = n % 10;
  const hundred = n % 100;
  const few = ten >= 2 && ten <= 4 && (hundred < 10 || hundred >= 20);
  return `${n} ${few ? "osoby" : "osób"}`;
}

const initials = (name: string) =>
  name.split(/\s+/).map((p) => p[0]).filter(Boolean).slice(0, 2).join("").toUpperCase();

const metaParts = [...meta, headcount(count)];
---
<dialog
  class="person group-dialog"
  id={id}
  data-group-dialog
  aria-labelledby={`${id}-title`}
>
  <form method="dialog" class="person__close-form">
    {/* `method="dialog"` closes without a line of JavaScript. */}
    <button class="person__close dialog-close" aria-label="Zamknij">×</button>
  </form>

  <div class="person__head">
    <h2 class="person__name dialog-title" id={`${id}-title`}>{title}</h2>
    <p class="group-dialog__meta">
      {metaParts.map((part, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <span>{part}</span>
        </>
      ))}
    </p>
  </div>

  <div class="group-dialog__scroll">
    {/* `pre-wrap`, because the API sends plain text with newlines rather than
        markup: rendered as one block, four paragraphs run into a wall. */}
    {description && <p class="group-dialog__desc">{description}</p>}

    {/* A plain list: no buttons, no links, nothing focusable. The photograph is
        decorative because the name is directly underneath it — alt text
        repeating it would have a screen reader read every person twice. */}
    <ul class="group-dialog__grid">
      {people.map((p) => (
        <li class="member">
          <span class="member__media">
            {p.image
              ? <img src={p.image} alt="" loading="lazy" width="160" height="213" />
              : <span class="member__monogram" aria-hidden="true">{initials(p.name)}</span>}
          </span>
          {/* Already abbreviated where the API decided it must be — a minor gets
              an abbreviated surname. Never expanded or re-joined here: the
              abbreviation IS the privacy control. */}
          <p class="member__name">{p.name}</p>
          {p.subtitle && <p class="member__role">{p.subtitle}</p>}
        </li>
      ))}
    </ul>
  </div>
</dialog>

<style>
  /* The shell, head, close button and backdrop come from tokens.css, which every
     dialog on the page shares. Only what is different about a GROUP is here. */

  /* WIDER than the person dialog's 420px: the content is a grid of people rather
     than one portrait. Overriding here rather than widening `.person` keeps the
     other dialogs at the widths their content was measured for. */
  .group-dialog {
    width: min(880px, calc(100vw - 32px));
    /* `svh`, not `vh`: on mobile `vh` is the viewport with the browser chrome
       retracted, so a 100vh-tall dialog is taller than what can be seen. */
    max-height: calc(100svh - var(--space-4) * 2);
  }
  /* `[open]`, NEVER the bare class: the UA stylesheet hides a closed dialog with
     `display: none`, and an unqualified `display: flex` would override it and
     leave the dialog permanently on the page. */
  .group-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  /* The name stays put while a long remit and roster scroll under it. */
  .group-dialog .person__head { flex: none; }
  .group-dialog__scroll {
    flex: 1 1 auto;
    overflow-y: auto;
    margin-top: var(--space-4);
  }

  .group-dialog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  .group-dialog__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    white-space: pre-wrap;
  }

  .group-dialog__grid {
    display: grid;
    /* auto-fill with a 120px floor: six across in the widest dialog, two on a
       phone, with no breakpoint of its own. */
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member { text-align: center; }
  .member__media {
    position: relative;
    display: grid;
    place-items: center;
    /* 3:4, the proportion the cards and the other dialogs use, so the same
       photograph is not a different shape in two places. */
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 10px;
    background: linear-gradient(160deg, #1f2a36, #0d1116);
  }
  .member__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .member__monogram {
    color: rgba(255, 255, 255, 0.65);
    font-size: 28px;
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
  }
  .member__name {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-subhead);
    line-height: 1.3;
  }
  .member__role {
    margin: 2px 0 0;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }
</style>

<script>
  // Opening and closing, for every card and dialog on the page — the rosters
  // here and the document shelves in ShelfDialog alike, since both use the same
  // two attributes.
  //
  // GUARDED, because that component ships the identical script: Astro hoists
  // each component's script once, so both would run and the second
  // `showModal()` on an already-open dialog would throw. First one in wins.
  if (!window.__pzsurfDialogsBound) {
    window.__pzsurfDialogsBound = true;

    for (const card of document.querySelectorAll<HTMLElement>("[data-open-group]")) {
      card.addEventListener("click", () => {
        const id = card.dataset.openGroup;
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    }

    // Click outside to close. A dialog element covers the whole viewport
    // including its backdrop, so a click landing on IT rather than on its
    // contents is a click on the backdrop.
    for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-group-dialog]")) {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  }
</script>
