---
import "../styles/tokens.css";
import "../styles/a11y.css";
import A11yPanel from "../components/A11yPanel.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { GA_ID } from "../lib/analytics";

interface Props {
  /** The browser tab, and the default for the share title. */
  title: string;
  description: string;
  /** Absolute share image. Defaults to the hero poster, so a link shared from
   *  anywhere on the site previews with the federation's own imagery rather
   *  than a blank card. */
  image?: string;
}
const { title, description, image } = Astro.props;

// Astro.site comes from astro.config.mjs, so these resolve absolute in the
// built file — which is the point: a crawler reading the raw HTML has no base
// to resolve a relative URL against.
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image ?? "/hero-poster.jpg", Astro.site);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The federation's mark, copied into this repo rather than linked from
        surfpoland.com: a site that cannot render without another site's assets
        is not actually independent, and a hotlink breaks the day that path
        changes. */}
    <link rel="icon" type="image/png" href="/pzsurf-mark.png" />
    <link rel="apple-touch-icon" href="/pzsurf-mark.png" />
    <meta name="theme-color" content="#000000" />

    {/* The reason this site is generated at all: the messengers people share
        links in do not run JavaScript, so these have to be in the file as
        written rather than added by a script. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polski Związek Surfingu" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The reader's accessibility settings (A11yPanel), applied BEFORE the
        first paint so a reader who needs high contrast never sees the page
        flash in the default colours. Inline and tiny for that reason; the key
        list mirrors lib/a11y.ts. */}
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem("pzsurf-a11y") || "{}");
        for (var k of ["text", "contrast", "links", "spacing", "motion", "images", "font"]) {
          if (typeof s[k] === "string") document.documentElement.dataset["a11y" + k[0].toUpperCase() + k.slice(1)] = s[k];
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    {/* FIRST in the body, before even the skip link, as GOV.UK places it: the
        question is answered once and then gone, and a screen reader should
        meet it before the page rather than after. Only when analytics is
        configured — no analytics, nothing to ask. */}
    {/* In `astro dev` it is always in the markup (hidden) so `?consent` can
        show it for work on the banner itself — see ConsentBanner. */}
    {(GA_ID || import.meta.env.DEV) && <ConsentBanner />}
    <slot />
    {/* Last in the document, so it is the last tab stop: it never stands
        between a keyboard and the content. */}
    <A11yPanel />

    <script>
      // BACK INTO AN OPEN DIALOG. Every page of this site opens in the same tab,
      // and some are reached from inside a dialog (an uchwała from the Uchwały
      // list, a notice from "wszystkie ogłoszenia", the accessibility statement
      // from the a11y panel). The back arrow (BackButton) is `history.back()`,
      // and where the browser restores the page from its back/forward cache
      // the dialog is still open. Where it reloads the page instead, it would
      // come back closed — so the dialog's id is written into this history
      // entry on the way out and reopened on the way back.
      const KEY = "pzsurfDialog";

      document.addEventListener("click", (e) => {
        const link = (e.target as Element | null)?.closest?.("a[href]");
        const dialog = link?.closest("dialog[open][id]");
        if (!(link instanceof HTMLAnchorElement) || !dialog) return;
        if (link.target || link.origin !== location.origin) return;
        history.replaceState({ ...history.state, [KEY]: dialog.id }, "");
      });

      // Closed by hand after coming back: forget it, or the next "back" onto
      // this entry would open it again.
      document.addEventListener("close", (e) => {
        if (history.state?.[KEY] !== (e.target as Element).id) return;
        const { [KEY]: _, ...rest } = history.state;
        history.replaceState(rest, "");
      }, true);

      window.addEventListener("pageshow", (e) => {
        const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
        if (e.persisted || nav?.type !== "back_forward") return;   // cache restored it, or not a "back"
        const id = history.state?.[KEY];
        const dialog = id ? document.getElementById(id) : null;
        if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
      });
    </script>
  </body>
</html>
