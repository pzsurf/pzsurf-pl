---
// THROWAWAY: the cookie spike (pzsurf-member-area-plan.md, slice 1). A test
// bench for the owner, not a page for members: English, unstyled, linked from
// nowhere, noindex, and only in builds with PUBLIC_MEMBER_AREA=true. Deleted,
// with its route in src/member/integration.ts, once the spike has reported.
//
// What it proves, per browser: sign in through Firebase (Google popup, or an
// email link), hand the ID token to the API on api.pzsurf.pl, and see whether
// the HttpOnly __session cookie it sets comes back on the next call. Firebase
// keeps nothing: in-memory persistence, and signed out once the cookie is set.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Member cookie spike</title>
    <style>
      body { font: 16px/1.5 system-ui, sans-serif; margin: 0 auto; max-width: 40rem; padding: 1rem; }
      section { border-top: 1px solid #ccc; padding: .75rem 0; }
      button, input { font: inherit; padding: .4rem .6rem; margin: .2rem 0; }
      input { width: 100%; box-sizing: border-box; }
      pre { background: #f4f4f4; padding: .75rem; white-space: pre-wrap; word-break: break-word; }
    </style>
  </head>
  <body>
    <main>
      <h1>Member cookie spike</h1>
      <p>Test bench for the pzsurf.pl member area. Not a public page.</p>

      <section>
        <h2>1. Sign in</h2>
        <button type="button" id="google">Sign in with Google</button>
        <p>
          <label for="email">Email</label>
          <input id="email" type="email" autocomplete="email" />
          <button type="button" id="send">Send sign-in link</button>
        </p>
        <p>
          <label for="link">The link from the email (long-press it, copy, paste here)</label>
          <input id="link" type="url" />
          <button type="button" id="finish">Finish with the link</button>
        </p>
      </section>

      <section>
        <h2>2. The cookie</h2>
        <button type="button" id="check">Check the cookie (GET)</button>
        <button type="button" id="out">Sign out (DELETE)</button>
      </section>

      <section>
        <h2>Result</h2>
        <pre id="log" aria-live="polite"></pre>
        <button type="button" id="copy">Copy the result</button>
      </section>
    </main>

    <script>
      import { initializeApp } from "firebase/app";
      import {
        initializeAuth, inMemoryPersistence, browserPopupRedirectResolver,
        GoogleAuthProvider, signInWithPopup, sendSignInLinkToEmail,
        isSignInWithEmailLink, signInWithEmailLink, signOut,
      } from "firebase/auth";
      import { FIREBASE_CONFIG, MEMBER_API, CSRF_HEADER } from "../../config";

      const SESSION = `${MEMBER_API}/_spike/session`;
      const EMAIL_KEY = "pzsurf-spike-email";
      const auth = initializeAuth(initializeApp(FIREBASE_CONFIG), {
        persistence: inMemoryPersistence,
        popupRedirectResolver: browserPopupRedirectResolver,
      });

      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const log = $("log");
      const lines: string[] = [`${navigator.userAgent}`, `page: ${location.origin}`, `api: ${SESSION}`];
      function say(label: string, value: unknown) {
        lines.push(`\n[${new Date().toISOString().slice(11, 19)}] ${label}`,
                   typeof value === "string" ? value : JSON.stringify(value, null, 2));
        log.textContent = lines.join("\n");     // textContent, never HTML
      }
      say("ready", "Sign in, then Check the cookie.");

      async function call(method: "GET" | "POST" | "DELETE", body?: unknown) {
        try {
          const r = await fetch(SESSION, {
            method, credentials: "include",
            headers: method === "GET" ? {} : { ...CSRF_HEADER, "content-type": "application/json" },
            body: body === undefined ? undefined : JSON.stringify(body),
          });
          const text = await r.text();
          let json: unknown = text;
          try { json = JSON.parse(text); } catch {}
          say(`${method} → ${r.status}`, json);
        } catch (e) {
          say(`${method} failed (network or CORS)`, String(e));
        }
      }

      async function handOver(how: string) {
        const user = auth.currentUser;
        if (!user) return say(how, "no Firebase user");
        say(`${how}: signed in to Firebase`, user.email ?? "(no email)");
        await call("POST", { firebase_id_token: await user.getIdToken() });
        await signOut(auth);
        say("Firebase", "signed out (only the cookie remains)");
        await call("GET");
      }

      $("google").addEventListener("click", async () => {
        try {
          await signInWithPopup(auth, new GoogleAuthProvider());
          await handOver("Google");
        } catch (e) { say("Google failed", String(e)); }
      });

      $("send").addEventListener("click", async () => {
        const email = $("email").value.trim();
        if (!email) return say("email", "enter an address first");
        try {
          await sendSignInLinkToEmail(auth, email, {
            url: `${location.origin}${location.pathname}`, handleCodeInApp: true,
          });
          try { localStorage.setItem(EMAIL_KEY, email); } catch {}
          say("email link", `sent to ${email}. Copy the link from the email and paste it above.`);
        } catch (e) { say("send failed", String(e)); }
      });

      async function finish(link: string) {
        if (!isSignInWithEmailLink(auth, link)) return say("email link", "that is not a sign-in link");
        let email = $("email").value.trim();
        if (!email) { try { email = localStorage.getItem(EMAIL_KEY) || ""; } catch {} }
        if (!email) return say("email link", "enter the address the link was sent to, then Finish again");
        try {
          await signInWithEmailLink(auth, email, link);
          await handOver("email link");
        } catch (e) { say("email link failed", String(e)); }
      }
      $("finish").addEventListener("click", () => finish($("link").value.trim()));
      // Opened straight from a link that points here.
      if (isSignInWithEmailLink(auth, location.href)) finish(location.href);

      $("check").addEventListener("click", () => call("GET"));
      $("out").addEventListener("click", () => call("DELETE"));
      $("copy").addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(log.textContent || ""); say("copied", "result on the clipboard"); }
        catch (e) { say("copy failed", String(e)); }
      });
    </script>
  </body>
</html>
